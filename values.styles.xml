<resources>
    <style name="Theme.AlgebraicVarietyExplorer" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="ExplorerButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/paper</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:backgroundTint">@color/accent_dark</item>
    </style>
</resources>
