#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 9) {
  echo 'usage: grease qualify-installed.grease EXPLORER SDK ADB SERIAL EXPECTED_API UNSIGNED_APK_EVIDENCE FRESH_OUTPUT SMALI BAKSMALI' >&2
  exit 2
}
var repository = ARGV[0]
var sdk = ARGV[1]
var adb = ARGV[2]
var serial = ARGV[3]
var expected_api = ARGV[4]
var packaged = ARGV[5]
var output = ARGV[6]
var smali = ARGV[7]
var baksmali = ARGV[8]
if (expected_api !== '23' and expected_api !== '34' and expected_api !== '35') {
  echo 'FAIL expected API must be exactly 23, 34 or 35' >&2; exit 2
}
for path in "$repository" "$sdk" "$adb" "$packaged" "$output" "$smali" "$baksmali" {
  if (path[0] !== '/') { echo 'FAIL absolute installed-qualification paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused installed qualification output' >&2; exit 1 }
var tools = "$sdk/build-tools/35.0.1"
var aapt2 = "$tools/aapt2"
var align = "$tools/zipalign"
var signer = "$tools/apksigner"
var platform = "$sdk/platforms/android-35/android.jar"
var keytool = $(command -v keytool)
var timeout = $(command -v timeout)
for program in "$adb" "$aapt2" "$align" "$signer" "$keytool" "$timeout" { test -x "$program" }
test -s "$platform"
rg '^Pkg.Revision[[:space:]]*=[[:space:]]*35\.0\.1$' "$tools/source.properties"
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
rg -x 'unsigned_pure_DEX_APK[[:space:]]PASS' "$packaged/result.tsv"
var apk_name = $(cat "$packaged/apk-name.txt")
printf '%s\n' "$apk_name" | rg -x 'Algebraic-Variety-Explorer-[0-9A-Za-z._-]+-unsigned[.]apk'
var candidate = "$packaged/$apk_name"
test -s "$candidate"
var expected = $(sed -n 's/^\([0-9a-f]\{64\}\)  .*unsigned[.]apk$/\1/p' "$packaged/artifacts.sha256")
test "$expected" = $(sha256sum "$candidate" | cut -d ' ' -f 1)
mkdir -p "$output/diagnostics" "$output/observer"
var state = $("$timeout" 20 "$adb" -s "$serial" get-state | tr -d '\r')
var sdk_level = $("$timeout" 20 "$adb" -s "$serial" shell getprop ro.build.version.sdk | tr -d '\r')
var abi = $("$timeout" 20 "$adb" -s "$serial" shell getprop ro.product.cpu.abi | tr -d '\r')
var qemu = $("$timeout" 20 "$adb" -s "$serial" shell getprop ro.kernel.qemu | tr -d '\r')
var user = 'UNKNOWN'
if (expected_api === '23') {
  # AOSP6 am has no get-current-user. Its process dump exposes the exact
  # started-user set and current-user history; require both to contain only0.
  "$timeout" 20 "$adb" -s "$serial" shell dumpsys activity processes > "$output/diagnostics/api23-user-processes.raw.txt"
  tr -d '\r' < "$output/diagnostics/api23-user-processes.raw.txt" > "$output/diagnostics/api23-user-processes.txt"
  var only_zero = true
  for label in mStartedUserArray mUserLru {
    # The explicit processes dump uses dumpAll=true and prints its started
    # array twice. Both declarations must be the same singleton [0].
    var expected_declarations = '1'
    if (label === 'mStartedUserArray') { setvar expected_declarations = '2' }
    var declared = '^[[:space:]]*' ++ label ++ ':'
    var singleton = '^[[:space:]]*' ++ label ++ r': \[0\]$'
    try { rg -c "$declared" "$output/diagnostics/api23-user-processes.txt" > "$output/diagnostics/$label-declarations.txt" }
    var declared_status = _error.code
    try { rg -c "$singleton" "$output/diagnostics/api23-user-processes.txt" > "$output/diagnostics/$label-singleton-zero.txt" }
    var singleton_status = _error.code
    if (declared_status !== 0 or singleton_status !== 0 or \
        $(cat "$output/diagnostics/$label-declarations.txt") !== expected_declarations or \
        $(cat "$output/diagnostics/$label-singleton-zero.txt") !== expected_declarations) {
      setvar only_zero = false
    }
  }
  if (only_zero) { setvar user = '0' }
  echo 'API23_exact_singleton_started_users_and_current_user_history' > "$output/diagnostics/user-identity-scope.txt"
} else {
  setvar user = $("$timeout" 20 "$adb" -s "$serial" shell am get-current-user | tr -d '\r')
  echo 'direct_am_get_current_user' > "$output/diagnostics/user-identity-scope.txt"
}
try { "$timeout" 20 "$adb" -s "$serial" shell 'command -v timeout' > "$output/diagnostics/remote-timeout-probe.txt" 2>&1 }
var timeout_probe = _error.code
var remote_timeout = $(tr -d '\r\n' < "$output/diagnostics/remote-timeout-probe.txt")
"$timeout" 20 "$adb" -s "$serial" shell pm list packages -u > "$output/diagnostics/packages-before.txt"
printf 'state\t%s\nexpected_API\t%s\nobserved_API\t%s\nABI\t%s\nqemu\t%s\nuser\t%s\nserial\t%s\nremote_timeout_probe_exit\t%s\nremote_timeout_path\t%s\n' \
  "$state" "$expected_api" "$sdk_level" "$abi" "$qemu" "$user" "$serial" \
  "$timeout_probe" "$remote_timeout" > "$output/diagnostics/preflight.tsv"
if (state !== 'device' or sdk_level !== expected_api or abi !== 'x86_64' or qemu !== '1' or user !== '0') {
  echo 'FAIL installed observer target differs from the exact declared API/x86_64/qemu1/user0' >&2; exit 1
}
var instrument_prefix = ''
if (remote_timeout === '/system/bin/timeout' and timeout_probe === 0) {
  setvar instrument_prefix = '/system/bin/timeout -s KILL 720 '
  echo 'remote_720seconds_and_host_740seconds' > "$output/diagnostics/instrumentation-timeout-scope.txt"
} else {
  if (expected_api !== '23' or remote_timeout !== '' or (timeout_probe !== 0 and timeout_probe !== 1)) {
    echo 'FAIL missing or unexpected system timeout outside the explicit API23 floor case' >&2; exit 1
  }
  echo 'API23_without_remote_timeout_host_740seconds_only' > "$output/diagnostics/instrumentation-timeout-scope.txt"
}
try { rg '^package:org\.algebraicvarietyexplorer(\.idricqualification)?\r?$' "$output/diagnostics/packages-before.txt" }
if (_error.code !== 1) { echo 'FAIL preexisting AVE package/data or package checker; no install attempted' >&2; exit 1 }
# This key exists only to exercise a fresh isolated emulator. It is not a
# production, C67, Wegert or IB identity and is never used by the producer.
var test_key_directory = $(mktemp -d /tmp/ave-emulator-signer.XXXXXXXX)
var test_key = "$test_key_directory/AVE-EMULATOR-TEST-ONLY.p12"
"$keytool" -genkeypair -noprompt -storetype PKCS12 -keystore "$test_key" \
  -storepass ave-emulator-test-only -keypass ave-emulator-test-only \
  -alias ave-emulator-test-only -keyalg RSA -keysize 2048 -validity 2 \
  -dname 'CN=AVE isolated emulator TEST ONLY' > "$output/test-only-key-generation.txt" 2>&1
"$keytool" -exportcert -keystore "$test_key" -storetype PKCS12 \
  -storepass ave-emulator-test-only -alias ave-emulator-test-only \
  -file "$output/AVE-EMULATOR-TEST-ONLY.cer" > "$output/test-only-certificate.txt" 2>&1
var example = "$repository/examples/autogenerated/pure-dex-apk"
cp -R "$example/observer" "$output/observer/source"
cp "$example/ObserverManifest.xml" "$output/observer/AndroidManifest.xml"
java -jar "$smali" assemble "$output/observer/source" -o "$output/observer/classes.dex"
java -jar "$baksmali" disassemble "$output/observer/classes.dex" -o "$output/observer/decoded"
try { rg '^\.class .*LIdric/' "$output/observer/decoded" }
if (_error.code !== 1) { echo 'FAIL observer impersonates checked candidate or class checker' >&2; exit 1 }
"$aapt2" link -o "$output/observer/resources.apk" --manifest "$output/observer/AndroidManifest.xml" \
  -I "$platform" --min-sdk-version 23 --target-sdk-version 35
cp "$output/observer/resources.apk" "$output/observer/unaligned.apk"
setglobal ENV.TZ = 'UTC'
touch -t 198001010000.00 "$output/observer/classes.dex"
cd "$output/observer"
zip -X -0 "$output/observer/unaligned.apk" classes.dex
"$align" -P 16 -f -v 4 "$output/observer/unaligned.apk" "$output/observer/unsigned.apk" > "$output/observer/alignment.txt"
"$signer" sign --ks "$test_key" --ks-type PKCS12 --ks-key-alias ave-emulator-test-only \
  --ks-pass pass:ave-emulator-test-only --key-pass pass:ave-emulator-test-only \
  --out "$output/AVE-EMULATOR-TEST-ONLY.apk" "$candidate" > "$output/test-only-app-signing.txt" 2>&1
"$signer" sign --ks "$test_key" --ks-type PKCS12 --ks-key-alias ave-emulator-test-only \
  --ks-pass pass:ave-emulator-test-only --key-pass pass:ave-emulator-test-only \
  --out "$output/OBSERVER-EMULATOR-TEST-ONLY.apk" "$output/observer/unsigned.apk" > "$output/test-only-observer-signing.txt" 2>&1
rm "$test_key"
rmdir "$test_key_directory"
for name in AVE OBSERVER {
  "$signer" verify --verbose --print-certs "$output/$name-EMULATOR-TEST-ONLY.apk" > "$output/$name-certificate.txt"
  "$align" -P 16 -c -v 4 "$output/$name-EMULATOR-TEST-ONLY.apk" > "$output/$name-alignment.txt"
}
var app_certificate = $(sed -n 's/^Signer #1 certificate SHA-256 digest: //p' "$output/AVE-certificate.txt")
var observer_certificate = $(sed -n 's/^Signer #1 certificate SHA-256 digest: //p' "$output/OBSERVER-certificate.txt")
printf '%s\n' "$app_certificate" | rg -x '[0-9a-f]{64}'
test "$app_certificate" = "$observer_certificate"
mkdir -p "$output/signed-payload"
unzip -q "$output/AVE-EMULATOR-TEST-ONLY.apk" classes.dex 'lib/*' 'assets/licenses/*' -d "$output/signed-payload"
cmp "$packaged/extracted/classes.dex" "$output/signed-payload/classes.dex"
for abi in arm64-v8a armeabi-v7a x86_64 { cmp "$packaged/extracted/lib/$abi/libave.so" "$output/signed-payload/lib/$abi/libave.so" }
for license in PROJECT-LICENSE NOTICE THIRD_PARTY_LICENSES.md vecmath-GPL-2-CE.txt {
  cmp "$packaged/extracted/assets/licenses/$license" "$output/signed-payload/assets/licenses/$license"
}
"$aapt2" dump badging "$output/AVE-EMULATOR-TEST-ONLY.apk" > "$output/app-badging.txt"
"$aapt2" dump badging "$output/OBSERVER-EMULATOR-TEST-ONLY.apk" > "$output/observer-badging.txt"
rg -F "package: name='org.algebraicvarietyexplorer'" "$output/app-badging.txt"
rg -F "package: name='org.algebraicvarietyexplorer.idricqualification'" "$output/observer-badging.txt"
sha256sum "$candidate" "$output/AVE-EMULATOR-TEST-ONLY.apk" "$output/OBSERVER-EMULATOR-TEST-ONLY.apk" \
  "$output/AVE-EMULATOR-TEST-ONLY.cer" "$output/observer/classes.dex" > "$output/artifacts.sha256"
printf 'scope\tisolated API%s x86_64 emulator only\nsigner\tAVE throwaway TEST ONLY\ncertificate_SHA256\t%s\nproduction_C67_update_identity\tNOT_RUN\n' \
  "$expected_api" "$app_certificate" > "$output/signing-scope.tsv"
proc snapshot(phase) {
  try { "$timeout" 30 "$adb" -s "$serial" logcat -b all -d -v threadtime > "$output/diagnostics/$phase-logcat.txt" 2>&1 }
  var logs = _error.code
  try {
    if (expected_api === '23') {
      "$timeout" 20 "$adb" -s "$serial" shell ps > "$output/diagnostics/$phase-processes.txt" 2>&1
    } else {
      "$timeout" 20 "$adb" -s "$serial" shell ps -A > "$output/diagnostics/$phase-processes.txt" 2>&1
    }
  }
  var processes = _error.code
  try { "$timeout" 20 "$adb" -s "$serial" shell dumpsys activity activities > "$output/diagnostics/$phase-activities.txt" 2>&1 }
  var activities = _error.code
  try { "$timeout" 20 "$adb" -s "$serial" shell dumpsys package org.algebraicvarietyexplorer > "$output/diagnostics/$phase-package.txt" 2>&1 }
  var package = _error.code
  printf 'logcat\t%s\nprocesses\t%s\nactivities\t%s\npackage\t%s\n' "$logs" "$processes" "$activities" "$package" > "$output/diagnostics/$phase-status.tsv"
  if (logs !== 0 or processes !== 0 or activities !== 0 or package !== 0) {
    echo 'FAIL incomplete installed Activity diagnostics' >&2; exit 1
  }
}
"$timeout" 20 "$adb" -s "$serial" shell getprop debug.checkjni > "$output/diagnostics/checkjni-before.txt"
try { "$timeout" 20 "$adb" -s "$serial" shell setprop debug.checkjni 1 > "$output/diagnostics/checkjni-enable.txt" 2>&1 }
var checkjni_status = _error.code
var checkjni = $("$timeout" 20 "$adb" -s "$serial" shell getprop debug.checkjni | tr -d '\r')
printf 'setprop_exit\t%s\nobserved_debug_checkjni\t%s\n' "$checkjni_status" "$checkjni" > "$output/diagnostics/checkjni.tsv"
if (checkjni === '1') {
  echo 'CheckJNI enabled for newly started installed process' > "$output/diagnostics/checkjni-result.txt"
} else {
  echo 'CheckJNI unavailable through emulator shell; no checked-JNI execution claim' > "$output/diagnostics/checkjni-result.txt"
}
printf '\033[36mACTION\033[0m install test-signed copies on empty API%s x86_64 emulator\n' "$expected_api"
try { "$timeout" 120 "$adb" -s "$serial" install --no-streaming -t "$output/AVE-EMULATOR-TEST-ONLY.apk" > "$output/install-app.txt" 2>&1 }
var install_app = _error.code
printf '%s\n' "$install_app" > "$output/install-app.exit"
cat "$output/install-app.txt"
if (install_app !== 0) { snapshot app-install-failure; echo 'FAIL fresh isolated AVE install' >&2; exit 1 }
rg -x 'Success\r?' "$output/install-app.txt"
try { "$timeout" 120 "$adb" -s "$serial" install --no-streaming -t "$output/OBSERVER-EMULATOR-TEST-ONLY.apk" > "$output/install-observer.txt" 2>&1 }
var install_observer = _error.code
printf '%s\n' "$install_observer" > "$output/install-observer.exit"
cat "$output/install-observer.txt"
if (install_observer !== 0) { snapshot observer-install-failure; echo 'FAIL independent observer install' >&2; exit 1 }
rg -x 'Success\r?' "$output/install-observer.txt"
"$timeout" 20 "$adb" -s "$serial" shell pm path org.algebraicvarietyexplorer > "$output/installed-app-path.txt"
var installed_path = $(sed -n 's/^package://p' "$output/installed-app-path.txt" | tr -d '\r')
if (not installed_path.startsWith('/data/app/') or not installed_path.endsWith('/base.apk')) {
  echo 'FAIL unexpected installed candidate path' >&2; exit 1
}
"$timeout" 30 "$adb" -s "$serial" pull "$installed_path" "$output/installed-base.apk" > "$output/installed-pull.txt" 2>&1
cmp "$output/AVE-EMULATOR-TEST-ONLY.apk" "$output/installed-base.apk"
for name in negative positive {
  var extra = ''
  if (name === 'negative') { setvar extra = '-e ave_negative_control blank_bitmap' }
  snapshot "$name-before"
  var marker_file = $(mktemp "$output/diagnostics/exit-token.XXXXXXXX")
  var nonce = $(basename "$marker_file" | tr -cd 'A-Za-z0-9')
  var marker = 'AVE_INSTALLED_API23_EXIT_' ++ name ++ '_' ++ nonce
  var marker_pattern = '^' ++ marker ++ '=[0-9]+$'
  try {
    if (expected_api === '23') {
      # Android's fixed shell frames a remote status absent from legacy adbd.
      "$timeout" --signal=TERM --kill-after=10s 740 "$adb" -s "$serial" shell -tt \
        "${instrument_prefix}am instrument -w -r $extra org.algebraicvarietyexplorer.idricqualification/org.algebraicvarietyexplorer.idricqualification.InstalledObserver; printf '\\n$marker=%s\\n' \"\$?\"" \
        > "$output/instrumentation-$name.pty.txt" 2>&1
    } else {
      "$timeout" --signal=TERM --kill-after=10s 740 "$adb" -s "$serial" shell -T \
        "${instrument_prefix}am instrument -w -r $extra org.algebraicvarietyexplorer.idricqualification/org.algebraicvarietyexplorer.idricqualification.InstalledObserver" \
        > "$output/instrumentation-$name.txt" 2>&1
    }
  }
  var transport = _error.code
  var execution = transport
  printf '%s\n' "$transport" > "$output/instrumentation-$name.transport-exit"
  if (expected_api === '23') {
    tr -d '\r' < "$output/instrumentation-$name.pty.txt" > "$output/instrumentation-$name.txt"
    printf '%s\n' "$marker" > "$output/instrumentation-$name.exit-marker"
    if (transport === 0) {
      try { rg -c "$marker_pattern" "$output/instrumentation-$name.txt" > "$output/instrumentation-$name.exit-marker-count" }
      var marker_status = _error.code
      if (marker_status !== 0 or $(cat "$output/instrumentation-$name.exit-marker-count") !== '1') {
        setvar execution = 1
      } else {
        var remote_exit = $(sed -n "s/^$marker=//p" "$output/instrumentation-$name.txt")
        printf '%s\n' "$remote_exit" > "$output/instrumentation-$name.remote-exit"
        if (remote_exit !== '0') { setvar execution = 1 }
      }
    }
  }
  printf '%s\n' "$execution" > "$output/instrumentation-$name.exit"
  snapshot "$name-after"
  cat "$output/instrumentation-$name.txt"
  if (execution !== 0) { echo 'FAIL installed Activity instrumentation execution' >&2; exit 1 }
  if (name === 'negative') {
    rg -x 'INSTRUMENTATION_RESULT: ave_observer_result=FAIL Explorer installed checked-DEX Activity\r?' "$output/instrumentation-$name.txt"
    rg -x 'INSTRUMENTATION_RESULT: ave_negative_control=blank_bitmap\r?' "$output/instrumentation-$name.txt"
    rg -x 'INSTRUMENTATION_RESULT: ave_negative_control_applied=true\r?' "$output/instrumentation-$name.txt"
    rg -x 'INSTRUMENTATION_RESULT: observer_cleanup=destroyed\r?' "$output/instrumentation-$name.txt"
    rg -x 'INSTRUMENTATION_RESULT: scenarios=0\r?' "$output/instrumentation-$name.txt"
    rg -x 'INSTRUMENTATION_CODE: 0\r?' "$output/instrumentation-$name.txt"
    rg -F 'actual ImageView Bitmap must contain more than one opaque pixel color' "$output/instrumentation-$name.txt"
  } else {
    rg -x 'INSTRUMENTATION_RESULT: ave_observer_result=PASS Explorer installed checked-DEX Activity\r?' "$output/instrumentation-$name.txt"
    rg -x 'INSTRUMENTATION_RESULT: scenarios=9\r?' "$output/instrumentation-$name.txt"
    rg -x 'INSTRUMENTATION_RESULT: png_export=PASS actual provider bytes dimensions pixels and descriptor close\r?' "$output/instrumentation-$name.txt"
    rg -x 'INSTRUMENTATION_CODE: -1\r?' "$output/instrumentation-$name.txt"
    try { rg 'FAIL Explorer installed' "$output/instrumentation-$name.txt" }
    if (_error.code !== 1) { echo 'FAIL positive instrumentation reported target failure or checker' >&2; exit 1 }
  }
  try { rg 'INSTRUMENTATION_FAILED|INSTRUMENTATION_ABORTED|shortMsg=' "$output/instrumentation-$name.txt" }
  if (_error.code !== 1) { echo 'FAIL instrumentation aborted or checker' >&2; exit 1 }
}
var png_token = $(sed -n 's/^INSTRUMENTATION_RESULT: png_export_token=\([0-9a-f]\{32\}\)\r\{0,1\}$/\1/p' "$output/instrumentation-positive.txt")
printf '%s\n' "$png_token" | rg -x '[0-9a-f]{32}'
"$timeout" 30 "$adb" -s "$serial" exec-out run-as org.algebraicvarietyexplorer.idricqualification \
  cat "files/export-$png_token.png" > "$output/actual-provider-export.png"
test -s "$output/actual-provider-export.png"
var png_magic = $(od -An -N8 -tx1 "$output/actual-provider-export.png" | tr -d ' \n')
test "$png_magic" = 89504e470d0a1a0a
sha256sum "$output/actual-provider-export.png" >> "$output/artifacts.sha256"
"$timeout" 20 "$adb" -s "$serial" shell pm list packages -u > "$output/diagnostics/packages-after.txt"
sha256sum "$output/installed-base.apk" >> "$output/artifacts.sha256"
printf 'installed_API%s_x86_64\tPASS\nexact_installed_candidate\tPASS\nblank_real_Bitmap_control_rejected\tPASS\nframework_Activity_9_scenarios\tPASS\nactual_ImageView_Bitmap\tPASS\nerror_keeps_prior_frame\tPASS\nDone_callback\tPASS\nExamples_dialog\tPASS\nPNG_picker_cancel_staging\tPASS\nactual_provider_PNG_signature_dimensions_pixels\tPASS\nactual_provider_PNG_descriptor_close\tPASS\nActivity_recreation_close\tPASS\nphysical_IME_pinch_system_picker_UI\tNOT_RUN\nproduction_update_identity\tNOT_RUN\nphysical_device\tNOT_RUN\n' "$expected_api" > "$output/result.tsv"
printf '\033[32mPASS\033[0m installed checked-DEX Activity in isolated API%s emulator; update identity and physical acceptance separate\n' "$expected_api"
