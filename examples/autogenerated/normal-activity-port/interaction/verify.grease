#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) {
  echo 'usage: grease verify.grease REPOSITORY FRONTEND_ROOT DRIVER_PROGRAM BACKEND_TTC DEPENDENCY_TTC BAKSMALI SMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var dependencies = ARGV[4]
var baksmali = ARGV[5]
var smali = ARGV[6]
var output = ARGV[7]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused interaction evidence' >&2; exit 1 }
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var source = "$repository/examples/autogenerated/normal-activity-port/interaction"
var scheme = "$frontend/.tools/bin/scheme"
var compiler = "$frontend/build/exec/idris2_app/idris2.so"
setglobal ENV.IDRIS2_PREFIX = "$frontend/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$modules:$dependencies"
setglobal ENV.IDRIS2_DATA = "$frontend/bootstrap-build/idris2-0.8.0/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/bootstrap-build/idris2-0.8.0/support/c"
setglobal ENV.IDRIS2_INC_SRC = "$frontend/build/exec/idris2_app"
setglobal ENV.LD_LIBRARY_PATH = "$frontend/build/exec/idris2_app"
setglobal ENV.CHEZ = scheme
setglobal ENV.PATH = "$frontend/.tools/bin:" ++ ENV.PATH
mkdir -p "$output/source" "$output/host" "$output/throttle-mutant/source" \
  "$output/float-mutant/source" "$output/quality-mutant/source"
cp "$repository/c-lua/idric/AVEInteraction.idric" "$source/InteractionCheck.idric" \
  "$source/InteractionExports.idric" "$output/source/"
git -C "$repository" rev-parse HEAD > "$output/repository-head.txt"
sha256sum "$output/source/AVEInteraction.idric" "$output/source/InteractionCheck.idric" \
  "$output/source/InteractionExports.idric" "$source/InteractionRunner.smali" \
  "$dependencies/2025081600/RenderQuality.ttc" "$compiler" "$driver" > "$output/inputs.sha256"

proc clean_log(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL interaction source diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL interaction diagnostic checker' >&2; exit 1 }
}
proc host_check(directory, destination) {
  mkdir -p "$destination"
  try {
    "$scheme" --program "$compiler" --source-dir "$directory" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$directory/InteractionCheck.idric" -o interaction-check > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  if (status !== 0) { echo 'FAIL interaction host source compilation' >&2; exit 1 }
  clean_log "$destination/compiler.txt"
  try {
    "$scheme" --program "$destination/interaction-check_app/interaction-check.so" \
      > "$destination/result.txt" 2>&1
  }
  var result = _error.code
  printf '%s\n' "$result" > "$destination/result.exit"
  cat "$destination/result.txt"
}
printf '\033[36mACTION\033[0m execute actual source state and throttle checks\n'
host_check "$output/source" "$output/host"
test $(cat "$output/host/result.exit") = 0
rg -x -F 'PASS Explorer interaction source state, throttle and quality selection' "$output/host/result.txt"
sed 's/render_at < 70/render_at < 71/' "$output/source/AVEInteraction.idric" \
  > "$output/throttle-mutant/source/AVEInteraction.idric"
cp "$source/InteractionCheck.idric" "$output/throttle-mutant/source/"
if cmp -s "$output/source/AVEInteraction.idric" "$output/throttle-mutant/source/AVEInteraction.idric" {
  echo 'FAIL unchanged throttle mutation' >&2; exit 1
}
host_check "$output/throttle-mutant/source" "$output/throttle-mutant/host"
test $(cat "$output/throttle-mutant/host/result.exit") = 1
rg -x -F 'FAIL Explorer interaction: at 70ms' "$output/throttle-mutant/host/result.txt"

proc emit(directory, destination) {
  mkdir -p "$destination"
  try {
    "$scheme" --program "$driver" --cg dex --directive managed-exports \
      --source-dir "$directory" --build-dir "$destination/build" \
      --output-dir "$destination" "$directory/InteractionExports.idric" -o candidate \
      > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  printf '%s\n' "$status" > "$destination/compiler.exit"
  cat "$destination/compiler.txt"
  if (status !== 0) { echo 'FAIL interaction checked source-to-DEX compilation' >&2; exit 1 }
  clean_log "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
printf '\033[36mACTION\033[0m emit actual Float32 interaction and Math.round sizing source\n'
emit "$output/source" "$output/positive"
emit "$output/source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -F 'sub-float' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/lang/Float;->doubleValue()D' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/lang/Math;->round(D)J' "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static interaction_request_width(ZII)I' "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static interaction_request_height(ZII)I' "$output/positive/decoded/Idric/Generated.smali"
sed 's/widen_coordinate (subtract_coordinates x previous_x)/(widen_coordinate x - widen_coordinate previous_x)/; s/widen_coordinate (subtract_coordinates y previous_y)/(widen_coordinate y - widen_coordinate previous_y)/' "$output/source/AVEInteraction.idric" \
  > "$output/float-mutant/source/AVEInteraction.idric"
sed 's/maximum_dimension Interactive = 144/maximum_dimension Interactive = 145/' \
  "$output/source/AVEInteraction.idric" > "$output/quality-mutant/source/AVEInteraction.idric"
for mutant in float-mutant quality-mutant {
  cp "$source/InteractionExports.idric" "$output/$mutant/source/"
  if cmp -s "$output/source/AVEInteraction.idric" "$output/$mutant/source/AVEInteraction.idric" {
    echo 'FAIL unchanged interaction source mutation' >&2; exit 1
  }
  emit "$output/$mutant/source" "$output/$mutant"
  if cmp -s "$output/positive/candidate.dex" "$output/$mutant/candidate.dex" {
    echo 'FAIL unchanged interaction mutation DEX' >&2; exit 1
  }
}
java -jar "$smali" assemble "$source/InteractionRunner.smali" -o "$output/runner.dex"
sha256sum "$output/positive/candidate.dex" "$output/float-mutant/candidate.dex" \
  "$output/quality-mutant/candidate.dex" "$output/runner.dex" > "$output/candidates.sha256"
printf 'source_typecheck\tPASS\nhost_state_and_throttle\tPASS\nhost_throttle_mutation\tREJECTED\nchecked_source_DEX\tPASS\nindependent_decode\tPASS\nInt64_to_Int32_rounding_result\tCOMPILED\nsource_mutations\tBUILT\nART\tPENDING\nnormal_Activity\tPENDING\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m interaction host state, exact source-to-DEX and mutation emission; ART pending\n'
