#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 8) {
  echo 'usage: grease repackage.grease WORKFLOW_SOURCE FROZEN_SOURCE GREASE SDK NDK CHECKED_SOURCE_ARTIFACT NATIVE_ARTIFACTS FRESH_OUTPUT' >&2
  exit 2
}
var workflow = ARGV[0]
var frozen = ARGV[1]
var grease = ARGV[2]
var sdk = ARGV[3]
var ndk = ARGV[4]
var checked = ARGV[5]
var native = ARGV[6]
var output = ARGV[7]
var head = 'b779e912328fa52a5f5c6595b41b22608a590f68'
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute replay paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused installed-replay output' >&2; exit 1 }
test -x "$grease"
var frozen_head = $(git -C "$frozen" rev-parse HEAD)
if (frozen_head !== head) {
  echo 'FAIL replay requires the frozen b779 source; current material cannot qualify the old candidate' >&2
  exit 1
}
var changed = $(git -C "$frozen" status --porcelain --untracked-files=no)
if (changed !== '') { echo 'FAIL frozen candidate tracked source was modified' >&2; exit 1 }
var activity = "$checked/formula-evidence/normal-activity"
test $(cat "$activity/repository-head.txt") = "$head"
var example = "$frozen/examples/autogenerated/pure-dex-apk"
printf '%s  %s\n' 77e6e1955f702b8756d15b9bec526944be99446bc001feb84f90f043e5004115 "$example/package.grease" | sha256sum -c -
printf '%s  %s\n' ed018b4160fd1ecc167965e6ea3ca5a1627d27753979c3bf38f1d63b0fc5f30d "$example/qualify-installed.grease" | sha256sum -c -
mkdir -p "$output/evidence" "$output/native-input"
printf 'candidate_source_head\t%s\ncandidate_workflow_run\t43829052041\nworkflow_source_head\t%s\nclassification\tfrozen-candidate diagnostic replay only\ncurrent_head_acceptance\tNOT_RUN\nphysical_device\tNOT_RUN\nproduction_update_identity\tNOT_RUN\n' \
  "$head" $(git -C "$workflow" rev-parse HEAD) > "$output/provenance.tsv"
printf 'artifact\tID\nexplorer-formula\t14207839986\narm64-v8a\t14208823177\narmeabi-v7a\t14208009901\nx86_64\t14208654512\n' > "$output/evidence/pinned-artifacts.tsv"
git -C "$frozen" status --porcelain --untracked-files=no > "$output/evidence/frozen-source-status.txt"
cp "$activity/repository-head.txt" "$output/evidence/Activity-source-head.txt"
for abi in arm64-v8a armeabi-v7a x86_64 {
  var profile = "$native/$abi/prepared-render-api23"
  rg -x "application[[:space:]]$head" "$profile/inputs.tsv"
  rg -x "abi[[:space:]]$abi" "$profile/inputs.tsv"
  cp -R "$profile" "$output/native-input/$abi"
}
cp "$example/package.grease" "$output/evidence/original-package.grease"
cp "$example/qualify-installed.grease" "$output/evidence/original-qualify-installed.grease"
cp -R "$example/observer" "$output/evidence/original-observer"
cp "$example/ObserverManifest.xml" "$output/evidence/original-ObserverManifest.xml"
var patched = "$output/evidence/package-minSdk-diagnostic.grease"
sed 's/sdkVersion:/minSdkVersion:/' "$output/evidence/original-package.grease" > "$patched"
printf '%s  %s\n' 01520bf79898e072bb5ca34ff5b5ca04c2d719440ffcdeb8ccbe0eab8ff7f600 "$patched" | sha256sum -c -
try {
  git diff --no-index "$output/evidence/original-package.grease" "$patched" > "$output/evidence/only-diagnostic-literal.patch"
}
if (_error.code !== 1) { echo 'FAIL expected exact old diagnostic repair diff' >&2; exit 1 }
sha256sum "$output/evidence/original-package.grease" "$patched" \
  "$example/qualify-installed.grease" "$activity/candidate.dex" > "$output/evidence/replay-inputs.sha256"
"$grease" -n "$patched" > "$output/evidence/package.syntax.txt"
"$grease" -n "$example/qualify-installed.grease" > "$output/evidence/installed.syntax.txt"
printf '\033[36mACTION\033[0m repackage frozen b779 candidate with the observed minimum-SDK diagnostic correction\n'
try {
  "$grease" "$patched" "$frozen" "$sdk" "$ndk" "$activity" "$output/native-input" "$output/unsigned" \
    > "$output/package.txt" 2>&1
}
var status = _error.code
printf '%s\n' "$status" > "$output/package.exit"
cat "$output/package.txt"
if (status !== 0) { echo 'FAIL frozen candidate packaging replay' >&2; exit 1 }
test $(cat "$output/unsigned/evidence/packaging-head.txt") = "$head"
rg -x 'unsigned_pure_DEX_APK[[:space:]]PASS' "$output/unsigned/result.tsv"
printf '\033[32mPASS\033[0m frozen b779 unsigned packaging replay; installed behavior remains separate\n'
