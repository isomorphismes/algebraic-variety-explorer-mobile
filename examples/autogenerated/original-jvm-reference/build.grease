#!/usr/bin/env grease
# Original Java oracle only. No classes from this helper enter the candidate APK.
set -eu -o pipefail
if (len(ARGV) < 2 or len(ARGV) > 4) {
  echo 'usage: grease build.grease EXPLORER test|preview [ABSOLUTE_OUTPUT [FORMULA]]' >&2
  exit 2
}
var repository = ARGV[0]
var action = ARGV[1]
if (len(repository) === 0 or repository[0] !== '/') {
  echo 'FAIL absolute original-reference repository required' >&2; exit 2
}
if (action !== 'test' and action !== 'preview') {
  echo 'FAIL original-reference action must be test or preview' >&2; exit 2
}
if (action === 'test' and len(ARGV) !== 2) {
  echo 'FAIL test action takes no preview arguments' >&2; exit 2
}
var preview = "$repository/.build/jsurf-preview.ppm"
var formula = 'x^2+y^2+z^2-0.64'
if (len(ARGV) >= 3) { setvar preview = ARGV[2] }
if (len(ARGV) === 4) { setvar formula = ARGV[3] }
if (len(preview) === 0 or preview[0] !== '/') {
  echo 'FAIL absolute original-reference preview output required' >&2; exit 2
}
test $(git -C "$repository" rev-parse --show-toplevel) = $(realpath "$repository")
test -s "$repository/dependencies.lock"
test -s "$repository/JsurfCoreTest.test.java"
test -s "$repository/JsurfPreview.test.java"
var grease = $(command -v grease)
var javac = ''
var java = ''
try { setvar javac = $(command -v javac) }
if (_error.code !== 0 or len(javac) === 0) {
  echo 'FAIL original-reference JDK 17 compiler is unavailable; reference not executed' >&2; exit 1
}
try { setvar java = $(command -v java) }
if (_error.code !== 0 or len(java) === 0) {
  echo 'FAIL original-reference JDK 17 runtime is unavailable; reference not executed' >&2; exit 1
}
var javac_version = $("$javac" --version)
printf '%s\n' "$javac_version" | rg '^javac 17[.]'
var java_version = $("$java" -XX:-UsePerfData -version 2>&1)
printf '%s\n' "$java_version" | rg '^(openjdk|java) version "17[.]'
var work = "$repository/.build/test"
mkdir -p "$repository/.build"
var dependency_evidence = $(mktemp -d "$repository/.build/original-reference-jars.XXXXXX")
rmdir "$dependency_evidence"
"$grease" "$repository/examples/autogenerated/polynomial-qualification/prepare-dependencies.grease" \
  "$repository" "$dependency_evidence"
var jars = "$dependency_evidence/antlr-runtime-3.4.jar:$dependency_evidence/vecmath-1.5.2.jar:$dependency_evidence/junit-4.13.2.jar:$dependency_evidence/hamcrest-core-1.3.jar"
# This is the established reference-only directory, never the APK work directory.
rm -rf -- "$work"
mkdir -p "$work/classes" "$work/sources"
git -C "$repository" rev-parse HEAD > "$work/source-revision.txt"
printf '%s\n' "$javac_version" > "$work/javac-version.txt"
printf '%s\n' "$java_version" > "$work/java-version.txt"
sha256sum "$javac" "$java" > "$work/tools.sha256"
cp "$dependency_evidence/verified.tsv" "$work/dependencies.tsv"
var sources = []
setglobal ENV.LC_ALL = 'C'
for source in (io.glob(repository ++ '/*.java')) {
  try { rg -q '^package de[.]mfo[.]jsurf[.]' "$source" }
  var selected = _error.code
  if (selected === 0) {
    call sources->append(source)
  } elif (selected !== 1) {
    echo 'FAIL original-reference source selection failed' >&2; exit 1
  }
}
if (len(sources) === 0) { echo 'FAIL no original jsurf sources selected' >&2; exit 1 }
call sources->append("$repository/SurfaceExample.java")
call sources->append("$repository/SurfaceExamples.java")
for source in (io.glob(repository ++ '/*.test.java')) {
  var name = $(basename "$source" .test.java)
  cp "$source" "$work/sources/$name.java"
  call sources->append("$work/sources/$name.java")
}
sha256sum @sources > "$work/sources.sha256"
printf '\033[36mACTION\033[0m compile only the original JVM parser and renderer reference\n'
try {
  "$javac" --release 17 -encoding UTF-8 -classpath "$jars" -d "$work/classes" \
    @sources > "$work/compiler.txt" 2>&1
}
var compiler_status = _error.code
printf '%s\n' "$compiler_status" > "$work/compiler.exit"
cat "$work/compiler.txt"
if (compiler_status !== 0) {
  echo 'FAIL original-reference compilation; reference not executed' >&2
  exit "$compiler_status"
}
var classpath = "$work/classes:$jars"
printf 'original_JDK17_compile\tPASS\ncandidate_APK\tNOT_RUN\n' > "$work/result.tsv"
var execution_status = 0
if (action === 'test') {
  try {
    "$java" -XX:-UsePerfData -classpath "$classpath" \
      org.junit.runner.JUnitCore org.algebraicvarietyexplorer.render.JsurfCoreTest \
      > "$work/test.txt" 2>&1
  }
  setvar execution_status = _error.code
  cat "$work/test.txt"
} else {
  # Never mistake an earlier preview for an output of a failed invocation.
  if test -e "$preview" {
    echo 'FAIL refusing existing original-reference preview output' >&2; exit 1
  }
  mkdir -p $(dirname "$preview")
  try {
    "$java" -XX:-UsePerfData -classpath "$classpath" \
      org.algebraicvarietyexplorer.render.JsurfPreview "$preview" "$formula" \
      > "$work/preview.txt" 2>&1
  }
  setvar execution_status = _error.code
  cat "$work/preview.txt"
}
printf '%s\n' "$execution_status" > "$work/execution.exit"
if (execution_status !== 0) {
  echo 'FAIL original JVM reference execution' >&2
  exit "$execution_status"
}
if (action === 'preview') { test -s "$preview"; sha256sum "$preview" > "$work/preview.sha256" }
printf 'original_%s_execution\tPASS\n' "$action" >> "$work/result.tsv"
printf '\033[32mPASS\033[0m original JVM %s; candidate application acceptance remains separate\n' "$action"
