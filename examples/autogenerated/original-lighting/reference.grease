#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease reference.grease EXPLORER LOCKED_JAR_DIRECTORY FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var dependencies = ARGV[1]
var output = ARGV[2]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute original-lighting paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused original-lighting evidence' >&2; exit 1 }
command -v javac > /dev/null
command -v java > /dev/null
command -v rg > /dev/null
var baseline = 'cfd543e1886bc6b7eb9e1ede6641569b673aac8d'
git -C "$repository" cat-file -e "$baseline^{commit}"
var antlr = "$dependencies/antlr-runtime-3.4.jar"
var vecmath = "$dependencies/vecmath-1.5.2.jar"
printf '%s  %s\n' 5b7cf53b7b30b034023f58030c8147c433f2bee0fe7dec8fae6bebf3708c5a63 "$antlr" | sha256sum -c -
printf '%s  %s\n' 3558e81ca74c60dc01baca7ef05f48594bbaed43af45d4f1b9196e479734e675 "$vecmath" | sha256sum -c -
mkdir -p "$output/classes" "$output/original-source" "$output/repeat"
git -C "$repository" rev-parse HEAD > "$output/candidate-source-revision.txt"
git -C "$repository" rev-parse "$baseline^{commit}" > "$output/original-source-revision.txt"
git -C "$repository" archive --format=tar "$baseline" -- '*.java' | tar -xf - -C "$output/original-source"
proc verify(file, digest) {
  printf '%s  %s\n' "$digest" "$output/original-source/$file" | sha256sum -c -
}
verify RenderingTask.java baf98e09dd9794df896d6fc53320bfd6032c60e63cdf6e3975d4a192d2c95eb4
verify CPUAlgebraicSurfaceRenderer.java 979b3a57e0055e809b54abe41c6b98363ac57a3c3199ba16a0587c4bc3f43688
verify LightProducts.java 597bfdf20871e0024e81f1a838dd3f3e8fa5e1460569c506e9111514ee66a115
verify Material.java 2ba38b73ae7e25bfda7fc56820a818468791ea7e0382bc07aa62a0e45e702357
verify LightSource.java b5894704ea5a60d3ec0ae41e6c4a9a350e16b1c7f591316f2a4d2bb5b1cf5b27
verify RendererEngine.java b7b4053bb5af9e727e33b5d9df49fbdafaad97da3b0d2be9a089a0a19ed65283
verify SurfaceExamples.java 2c18a45279ed3c1260b1ba7265fad5ab8dedb783aaf44699ddd3079a22db96a0
javac --version > "$output/javac-version.txt" 2>&1
rg '^javac 17[.]' "$output/javac-version.txt"
java -XX:-UsePerfData -version > "$output/java-version.txt" 2>&1
rg '(openjdk|java) version "17[.]' "$output/java-version.txt"
printf 'role\toriginal-jsurf-test-only\nsource_target\tJava17\nFP\tJava17-strict-F32-F64\nJVM_flags\t-XX:-UsePerfData\nexecution\tactual-collected-products-and-shade\nframe_execution\tone-original-full-canvas-RenderingTask\nworker_partition_parity\tNOT_ESTABLISHED\n' > "$output/profile.tsv"
cd "$output/original-source"
rg -l '^package de[.]mfo[.]jsurf[.]' --glob '*.java' --maxdepth 1 . | LC_ALL=C sort > "$output/original-sources.txt"
xargs sha256sum < "$output/original-sources.txt" > "$output/original-sources.sha256"
var harness = "$repository/examples/autogenerated/original-lighting/OriginalLightingOracle.java"
sha256sum "$harness" "$antlr" "$vecmath" > "$output/adapter-and-dependencies.sha256"
javac --release 17 -cp "$antlr:$vecmath" -d "$output/classes" \
  "@$output/original-sources.txt" "$harness" > "$output/compiler.txt" 2>&1
for mode in lighting pixels additional-pixels rays ordered-workers {
  for copy in observations repeat {
    var destination = "$output/$mode.tsv"
    if (copy === 'repeat') { setvar destination = "$output/repeat/$mode.tsv" }
    java -XX:-UsePerfData -cp "$output/classes:$antlr:$vecmath" \
      de.mfo.jsurf.rendering.cpu.OriginalLightingOracle "$mode" > "$destination" 2> "$destination.stderr"
    test ! -s "$destination.stderr"
  }
  cmp "$output/$mode.tsv" "$output/repeat/$mode.tsv"
}
test $(rg -c b'^scene\t' "$output/lighting.tsv") = 6
test $(rg -c b'^scene_end\t' "$output/lighting.tsv") = 6
test $(rg -c b'^shade\t' "$output/lighting.tsv") = 288
test $(rg -c b'^ambient\t' "$output/lighting.tsv") = 12
test $(rg -c b'^products\t' "$output/lighting.tsv") = 26
test $(rg -c b'^frame\t' "$output/pixels.tsv") = 44
test $(rg -c b'^input\t' "$output/pixels.tsv") = 176
test $(rg -c b'^pixel\t' "$output/pixels.tsv") = 5412
test $(rg -c b'^frame\t' "$output/additional-pixels.tsv") = 2
test $(rg -c b'^input\t' "$output/additional-pixels.tsv") = 8
test $(rg -c b'^pixel\t' "$output/additional-pixels.tsv") = 286
test $(rg -c b'^frame\t' "$output/rays.tsv") = 44
test $(rg -c b'^captured_calls\t' "$output/rays.tsv") = 44
test $(rg -c b'^selected_ray\t' "$output/rays.tsv") = 238
test $(rg -c b'^selected_trace\t' "$output/rays.tsv") = 238
test $(rg -c b'^selected_end\t' "$output/rays.tsv") = 238
test $(rg -c b'^frame\t' "$output/ordered-workers.tsv") = 44
test $(rg -c b'^ordered_profile\t' "$output/ordered-workers.tsv") = 44
test $(rg -c b'^ordered_summary\t' "$output/ordered-workers.tsv") = 44
test $(rg -c b'^ordered_pixel\t' "$output/ordered-workers.tsv") = 5412
test $(rg -c b'^serial_ordered_match\t' "$output/ordered-workers.tsv") = 44
rg b'^ordered_profile\t|^ordered_summary\t|^serial_ordered_match\t' \
  "$output/ordered-workers.tsv" > "$output/ordered-summaries.tsv"
# Observe the actual production partition three times per frame. Differing
# overlapping-task results are retained rather than forced into equality.
java -XX:-UsePerfData -cp "$output/classes:$antlr:$vecmath" \
  de.mfo.jsurf.rendering.cpu.OriginalLightingOracle workers > "$output/workers.tsv" 2> "$output/workers.stderr"
test ! -s "$output/workers.stderr"
test $(rg -c b'^frame\t' "$output/workers.tsv") = 44
test $(rg -c b'^worker_frame\t' "$output/workers.tsv") = 132
test $(rg -c b'^worker_summary\t' "$output/workers.tsv") = 132
test $(rg -c b'^worker_pixel\t' "$output/workers.tsv") = 16236
rg b'^worker_summary\t' "$output/workers.tsv" > "$output/worker-summaries.tsv"
sha256sum "$output/lighting.tsv" "$output/pixels.tsv" "$output/additional-pixels.tsv" "$output/rays.tsv" \
  "$output/ordered-workers.tsv" "$output/ordered-summaries.tsv" \
  "$output/workers.tsv" "$output/worker-summaries.tsv" > "$output/observations.sha256"
printf 'frozen_original_source\tPASS\noriginal_Java17_compile\tPASS\nactual_collected_ambient_and_products\tPASS\nactual_RenderingTask_shade\tPASS\nactual_full_canvas_default_lit_frames\tPASS\nactual_selected_ray_components\tPASS\nactual_ordered_private_RenderingTask_tiles\tPASS\nactual_serial_draw_matches_ordered_tiles\tPASS\nrepeat_bytes\tPASS\nscenes\t6\nshade_cases\t288\nframes\t44\npixels\t5412\nselected_ray_records\t238\nadditional_Madore_frames\t2\nadditional_Madore_pixels\t286\nactual_production_worker_draws\t132\nworker_partition_comparison\tsee-worker-summaries.tsv\nordered_tile_comparison\tsee-ordered-summaries.tsv\ncandidate_C\tNOT_RUN\nfull_image_worker_parity\tNOT_ESTABLISHED\nAndroid\tNOT_RUN\nphysical_devices\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m actual original lighting and full-canvas reference; candidate C qualification separate\n'
