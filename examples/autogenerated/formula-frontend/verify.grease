#!/usr/bin/env grease
# Build host observation and the production direct-DEX parser separately.
if (len(ARGV) !== 5) {
  echo 'usage: grease verify.grease EXPLORER FRONTEND ANDROID_NDK FRESH_OUTPUT BAKSMALI' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var android = ARGV[2]
var output = ARGV[3]
var baksmali = ARGV[4]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused output' >&2; exit 1 }
command -v rg
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test $(git -C "$android" rev-parse HEAD) = dfcf2cb22c0ebcc4ce999189cc2f066593bf3689
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
var compiler = "$frontend/_/build/exec/idris2"
var backend = "$android/dex/idric"
var driver = "$backend/build/exec/idric-dex"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$output/source" "$output/host" "$output/positive" "$output/repeat" \
  "$output/mutant/source" "$output/semantic-mutant/source"
cp "$repository/c-lua/idric/AlgebraicExpression.idric" "$output/source/"
cp "$repository/c-lua/idric/PolynomialQualification.idric" "$output/source/"
cp "$repository/examples/autogenerated/formula-frontend/FormulaCheck.idric" "$output/source/"
cp "$repository/examples/autogenerated/formula-frontend/FormulaExports.idric" "$output/source/"
cp "$repository/examples/autogenerated/polynomial-qualification/PolynomialQualificationCheck.idric" "$output/source/"
cmp "$repository/c-lua/idric/AlgebraicExpression.idric" "$output/source/AlgebraicExpression.idric"
printf 'explorer\t%s\nfrontend\t%s\nbackend\t%s\n' \
  $(git -C "$repository" rev-parse HEAD) $(git -C "$frontend" rev-parse HEAD) \
  $(git -C "$android" rev-parse HEAD) > "$output/inputs.tsv"
sha256sum "$output/source/AlgebraicExpression.idric" "$output/source/FormulaCheck.idric" \
  "$output/source/FormulaExports.idric" "$output/source/PolynomialQualification.idric" \
  "$output/source/PolynomialQualificationCheck.idric" > "$output/sources.sha256"

proc clean_diagnostics(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) {
    echo 'FAIL source compiler reported an error' >&2
    exit 1
  }
  if (status !== 1) {
    echo 'FAIL compiler diagnostic checker could not read its input' >&2
    exit 1
  }
}
printf '\033[36mACTION\033[0m check and execute the actual Explorer parser on the host\n'
try {
  "$compiler" --source-dir "$output/source" --build-dir "$output/host/build" \
    --output-dir "$output/host" "$output/source/FormulaCheck.idric" -o formula-check \
    > "$output/host/compiler.txt" 2>&1
}
var host_status = _error.code
cat "$output/host/compiler.txt"
if (host_status !== 0) { echo 'FAIL host source compilation' >&2; exit 1 }
clean_diagnostics "$output/host/compiler.txt"
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/host/formula-check_app/"
"$output/host/formula-check" > "$output/host/result.txt" 2>&1
cat "$output/host/result.txt"
rg -x -F 'PASS Explorer Idriç source parser' "$output/host/result.txt"
try {
  "$compiler" --source-dir "$output/source" --build-dir "$output/host/build" \
    --output-dir "$output/host" "$output/source/PolynomialQualificationCheck.idric" -o qualification-check \
    > "$output/host/qualification-compiler.txt" 2>&1
}
var qualification_status = _error.code
cat "$output/host/qualification-compiler.txt"
if (qualification_status !== 0) { echo 'FAIL polynomial qualification compilation' >&2; exit 1 }
clean_diagnostics "$output/host/qualification-compiler.txt"
cp "$frontend/_/build/exec/idris2_app/libidris2_support.so" "$output/host/qualification-check_app/"
"$output/host/qualification-check" > "$output/host/qualification.txt" 2>&1
cat "$output/host/qualification.txt"
rg -x -F 'PASS Explorer polynomial qualification' "$output/host/qualification.txt"

proc emit_source(source, destination) {
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$source" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$source/FormulaExports.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { echo 'FAIL Explorer source-to-DEX compilation' >&2; exit 1 }
  clean_diagnostics "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
printf '\033[36mACTION\033[0m emit and independently decode the actual source parser\n'
emit_source "$output/source" "$output/positive"
emit_source "$output/source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -x -F '.method public static formula_shape(Ljava/lang/String;)Ljava/lang/String;' \
  "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static formula_qualification(Ljava/lang/String;)Ljava/lang/String;' \
  "$output/positive/decoded/Idric/Generated.smali"
# Mutate the actual precedence implementation, leaving the observer unchanged.
sed 's/Raised parsed.expression raised.expression/Product parsed.expression raised.expression/' \
  "$output/source/AlgebraicExpression.idric" > "$output/mutant/source/AlgebraicExpression.idric"
cp "$output/source/FormulaExports.idric" "$output/mutant/source/"
cp "$output/source/PolynomialQualification.idric" "$output/mutant/source/"
if cmp -s "$output/source/AlgebraicExpression.idric" "$output/mutant/source/AlgebraicExpression.idric" {
  echo 'FAIL unchanged parser mutant' >&2; exit 1
}
emit_source "$output/mutant/source" "$output/mutant"
if cmp -s "$output/positive/candidate.dex" "$output/mutant/candidate.dex" {
  echo 'FAIL source mutation produced the original candidate' >&2; exit 1
}
cp "$output/source/FormulaExports.idric" "$output/source/AlgebraicExpression.idric" "$output/semantic-mutant/source/"
sed 's/qualified_quotient _ (PolynomialMeaning _) = Left PolynomialDivisor/qualified_quotient left (PolynomialMeaning _) = Right (PolynomialMeaning (as_polynomial left))/' \
  "$output/source/PolynomialQualification.idric" > "$output/semantic-mutant/source/PolynomialQualification.idric"
if cmp -s "$output/source/PolynomialQualification.idric" "$output/semantic-mutant/source/PolynomialQualification.idric" {
  echo 'FAIL unchanged divisor restriction mutant' >&2; exit 1
}
emit_source "$output/semantic-mutant/source" "$output/semantic-mutant"
if cmp -s "$output/positive/candidate.dex" "$output/semantic-mutant/candidate.dex" {
  echo 'FAIL divisor mutation produced the original candidate' >&2; exit 1
}
sha256sum "$output/positive/candidate.dex" "$output/mutant/candidate.dex" \
  "$output/semantic-mutant/candidate.dex" > "$output/candidates.sha256"
printf '\033[32mPASS\033[0m host parser, checked DEX emission, independent decode and determinism; ART separate\n'
