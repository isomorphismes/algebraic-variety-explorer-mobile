#!/usr/bin/env grease
if (len(ARGV) !== 5) { echo 'usage: grease coefficients.grease EXPLORER FRONTEND ANDROID_NDK EVIDENCE ADB' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var android = ARGV[2]
var evidence = ARGV[3]
var adb = ARGV[4]
var source = "$repository/examples/autogenerated/formula-frontend/CoefficientCheck.idric"
var driver = "$android/dex/idric/build/exec/idric-dex"
command -v rg
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$android/dex/idric/build/ttc"
mkdir -p "$evidence/coefficient"
try {
  "$driver" --cg dex --source-dir "$repository/examples/autogenerated/formula-frontend" \
    --build-dir "$evidence/coefficient/build" --output-dir "$evidence/coefficient" \
    "$source" -o candidate > "$evidence/coefficient/compiler.txt" 2>&1
}
var status = _error.code
cat "$evidence/coefficient/compiler.txt"
printf 'compiler_exit\t%s\n' "$status" > "$evidence/coefficient/result.tsv"
if (status !== 0) {
  printf '\033[31mBLOCKED\033[0m actual binary64 coefficient program did not compile to DEX\n' >&2
  exit 1
}
try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$evidence/coefficient/compiler.txt" }
var diagnostic_status = _error.code
if (diagnostic_status === 0) {
  echo 'FAIL compiler returned success with diagnostics' >&2; exit 1
}
if (diagnostic_status !== 1) { echo 'FAIL compiler diagnostic checker could not read its input' >&2; exit 1 }
test -s "$evidence/coefficient/candidate.dex"
"$adb" -s emulator-5554 push "$evidence/coefficient/candidate.dex" /data/local/tmp/ave-coefficient.dex
"$adb" -s emulator-5554 shell chmod 444 /data/local/tmp/ave-coefficient.dex
"$adb" -s emulator-5554 pull /data/local/tmp/ave-coefficient.dex "$evidence/coefficient/received.dex"
cmp "$evidence/coefficient/candidate.dex" "$evidence/coefficient/received.dex"
"$adb" -s emulator-5554 shell 'CLASSPATH=/data/local/tmp/ave-coefficient.dex app_process /system/bin Idric.Generated 0.1' \
  > "$evidence/coefficient/art.txt" 2>&1
cat "$evidence/coefficient/art.txt"
rg -x -F '0.5' "$evidence/coefficient/art.txt"
printf '\033[32mPASS\033[0m explicit binary64 coefficient execution on ART\n'
