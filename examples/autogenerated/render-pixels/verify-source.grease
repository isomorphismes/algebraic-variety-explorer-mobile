#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'usage: grease verify-source.grease EXPLORER FRONTEND DRIVER FRESH_OUTPUT BAKSMALI SMALI' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var output = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused Bitmap evidence' >&2; exit 1 }
command -v rg
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
var example = "$repository/examples/autogenerated/render-pixels"
mkdir -p "$output/source" "$output/positive" "$output/repeat" \
  "$output/format-mutant/source" "$output/quality-mutant/source"
for module in AlgebraicExpression.idric PolynomialQualification.idric \
  CoefficientArithmetic.idr CoefficientValue.idric PreparedFormula.idric \
  OrderedExpansion.idric PreparedSurfaceTransfer.idric RenderQuality.idric RenderedBitmap.idric {
  cp "$repository/c-lua/idric/$module" "$output/source/"
}
cp "$example/RenderExports.idric" "$output/source/"
cp "$example/render-jni.tsv" "$output/render-jni.tsv"
git -C "$repository" rev-parse HEAD > "$output/source-revision.txt"
sha256sum "$output/source/RenderQuality.idric" "$output/source/RenderedBitmap.idric" "$output/source/RenderExports.idric" \
  "$output/render-jni.tsv" "$example/RenderBitmapObserver.smali" \
  "$example/RenderedBitmapRunner.smali" "$example/RenderPixelObserver.smali" \
  "$repository/native/android/render_surface_jni.c" "$repository/native/surfer_frame_output.c" \
  > "$output/sources.sha256"
proc emit(source, destination) {
  "$driver" --cg dex --directive managed-exports --directive "jni-map=$output/render-jni.tsv" \
    --source-dir "$source" --build-dir "$destination/build" --output-dir "$destination" \
    "$source/RenderExports.idric" -o candidate > "$destination/compiler.txt" 2>&1
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$destination/compiler.txt" }
  var diagnostics = _error.code
  if (diagnostics !== 1) { echo 'FAIL Bitmap source diagnostics or diagnostic checker' >&2; exit 1 }
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$output/source" "$output/positive"
emit "$output/source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
var decoded = "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static actual_render_check(Ljava/lang/String;I)Ljava/lang/String;' "$decoded"
rg -x -F '.method public static native renderPreparedSurface(JIIIDDDD[I)I' "$decoded"
rg -F 'Landroid/graphics/Bitmap;->createBitmap([IIILandroid/graphics/Bitmap$Config;)Landroid/graphics/Bitmap;' "$decoded"
rg -F 'Landroid/graphics/Bitmap$Config;->valueOf(Ljava/lang/String;)Landroid/graphics/Bitmap$Config;' "$decoded"
for mutant in format-mutant quality-mutant {
  for module in AlgebraicExpression.idric PolynomialQualification.idric \
    CoefficientArithmetic.idr CoefficientValue.idric PreparedFormula.idric \
    OrderedExpansion.idric PreparedSurfaceTransfer.idric RenderQuality.idric RenderExports.idric {
    cp "$output/source/$module" "$output/$mutant/source/"
  }
}
sed 's/bitmap_format "ARGB_8888"/bitmap_format "RGB_565"/' \
  "$output/source/RenderedBitmap.idric" > "$output/format-mutant/source/RenderedBitmap.idric"
sed 's/quality_selector Final = 1/quality_selector Final = 0/' \
  "$output/source/RenderedBitmap.idric" > "$output/quality-mutant/source/RenderedBitmap.idric"
for mutant in format-mutant quality-mutant {
  try { cmp -s "$output/source/RenderedBitmap.idric" "$output/$mutant/source/RenderedBitmap.idric" }
  var changed = _error.code
  if (changed !== 1) { echo 'FAIL unchanged Bitmap source mutant' >&2; exit 1 }
  emit "$output/$mutant/source" "$output/$mutant"
  try { cmp -s "$output/positive/candidate.dex" "$output/$mutant/candidate.dex" }
  var emitted = _error.code
  if (emitted !== 1) { echo 'FAIL unchanged compiled Bitmap source mutant' >&2; exit 1 }
}
java -jar "$smali" assemble "$example/RenderBitmapObserver.smali" "$example/RenderedBitmapRunner.smali" \
  "$example/RenderPixelObserver.smali" \
  "$repository/examples/autogenerated/copied-prepared-surface/CopiedSurfaceObserver.smali" \
  -o "$output/runner.dex"
java -jar "$baksmali" disassemble "$output/runner.dex" -o "$output/runner-decoded"
sha256sum "$output/positive/candidate.dex" "$output/repeat/candidate.dex" \
  "$output/format-mutant/candidate.dex" "$output/quality-mutant/candidate.dex" "$output/runner.dex" \
  > "$output/candidates.sha256"
printf 'actual_Bitmap_source_generation\tPASS\ndeterministic_repeat\tPASS\ncompiled_source_mutants\tGENERATED\nJNI_ART\tNOT_RUN\nActivity\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/source-result.tsv"
printf '\033[32mPASS\033[0m real Bitmap source, explicit quality and independently decoded mutants; JNI/ART separate\n'
