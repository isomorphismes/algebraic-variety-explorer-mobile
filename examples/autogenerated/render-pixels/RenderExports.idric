module RenderExports

import PreparedSurfaceTransfer
import RenderedBitmap
import OrderedExpansion
import CoefficientValue
import Data.Text

-- Independent test observer receives the real platform Bitmap. It performs no
-- candidate rendering and is not part of the maintained application module.
%foreign "dex:static:LRenderBitmapObserver;:observe:(Landroid/graphics/Bitmap;)V"
observe_bitmap : RenderedBitmap → PrimIO ()

settings_for : Int32 → RenderSettings
settings_for mode = RenderWith (if mode ≟ 1 then 0 else 37) 31
  (if mode ≟ 4 then Final else Interactive)
  (if mode ≟ 2 then 0.0 else 2.15) 0.37 (-0.19) 1.1

%export "dex:actual_render_prepare"
actual_render_prepare : Text → IO Int64
actual_render_prepare source = do
  prepared ← prepare_native_surface (BoundedExpansion 4096 262144) (\name ⇒ Nothing) source
  pure (case prepared of
    Left _ ⇒ 0
    Right surface ⇒ native_surface_handle surface)

%export "dex:actual_render_check"
actual_render_check : Text → Int32 → IO Text
actual_render_check source mode = do
  prepared ← prepare_native_surface (BoundedExpansion 4096 262144) (\name ⇒ Nothing) source
  case prepared of
    Left reason ⇒ pure ("preparation error: " ++ reason)
    Right surface ⇒ do
      -- Stale-handle refusal is a qualification mode, using a real released
      -- surface; no private NativeSurface constructor or forged pointer.
      _ ← if mode ≟ 3 then release_native_surface surface else pure (Right ())
      rendered ← render_native_bitmap surface (settings_for mode)
      released ← if mode ≟ 3 then pure (Right ()) else release_native_surface surface
      case released of
        Left reason ⇒ pure ("release error: " ++ reason)
        Right () ⇒ case rendered of
          Left reason ⇒ pure reason
          Right bitmap ⇒ do
            primIO (observe_bitmap bitmap)
            pure "rendered and observed"

main : IO ()
main = pure ()
