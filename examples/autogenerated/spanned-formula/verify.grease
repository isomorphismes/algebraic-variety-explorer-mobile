#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 7) {
  echo 'usage: grease verify.grease EXPLORER FRONTEND_ROOT DRIVER_PROGRAM BACKEND_TTC SMALI BAKSMALI FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var driver = ARGV[2]
var modules = ARGV[3]
var smali = ARGV[4]
var baksmali = ARGV[5]
var output = ARGV[6]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused span qualification output' >&2; exit 1 }
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
var scheme = "$frontend/.tools/chez-10.4.1/bin/scheme"
var compiler = "$frontend/build/exec/idris2_app/idris2.so"
setglobal ENV.SCHEMEHEAPDIRS = "$frontend/.tools/chez-10.4.1/lib/csv10.4.1/ta6le"
setglobal ENV.IDRIS2_PREFIX = "$frontend/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = modules
setglobal ENV.LD_LIBRARY_PATH = "$frontend/build/exec/idris2_app"
setglobal ENV.CHEZ = scheme
mkdir -p "$output/source" "$output/host" "$output/dex" "$output/span-mutant" "$output/category-mutant"
cp -R "$repository/c-lua/idric/." "$output/source/"
cp "$repository/examples/autogenerated/spanned-formula/SpanCheck.idric" \
  "$repository/examples/autogenerated/spanned-formula/SpanReports.idric" \
  "$repository/examples/autogenerated/spanned-formula/SpanExports.idric" \
  "$repository/examples/autogenerated/formula-frontend/FormulaCheck.idric" \
  "$repository/examples/autogenerated/polynomial-qualification/PolynomialQualificationCheck.idric" \
  "$output/source/"
git -C "$repository" rev-parse HEAD > "$output/repository-head.txt"
git -C "$repository" status --porcelain > "$output/repository-status.txt"
sha256sum "$compiler" "$driver" "$smali" "$baksmali" \
  "$output/source/AlgebraicExpression.idric" "$output/source/PolynomialQualification.idric" \
  "$output/source/PreparedFormula.idric" "$output/source/AVERenderController.idric" \
  "$output/source/SpanCheck.idric" "$output/source/SpanReports.idric" \
  "$output/source/SpanExports.idric" "$output/source/FormulaCheck.idric" \
  "$output/source/PolynomialQualificationCheck.idric" > "$output/inputs.sha256"

proc diagnostics(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  if (_error.code !== 1) { echo 'FAIL source diagnostics or checker' >&2; exit 1 }
}
proc host_program(source, destination, name) {
  mkdir -p "$destination"
  try {
    "$scheme" --program "$compiler" --source-dir "$source" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$source/$name.idric" -o check > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { echo 'FAIL host source compilation' >&2; exit 1 }
  diagnostics "$destination/compiler.txt"
  cp "$frontend/build/exec/idris2_app/libidris2_support.so" "$destination/check_app/"
  try { "$destination/check" > "$destination/result.txt" 2>&1 }
  var execution = _error.code
  printf '%s\n' "$execution" > "$destination/execution.exit"
  cat "$destination/result.txt"
}
printf '\033[36mACTION\033[0m execute located admission and established parser/semantic regressions\n'
host_program "$output/source" "$output/host/spans" SpanCheck
test $(cat "$output/host/spans/execution.exit") = 0
rg -x -F 'PASS Explorer spanned formula admission' "$output/host/spans/result.txt"
host_program "$output/source" "$output/host/parser" FormulaCheck
test $(cat "$output/host/parser/execution.exit") = 0
rg -x -F 'PASS Explorer Idriç source parser' "$output/host/parser/result.txt"
host_program "$output/source" "$output/host/meaning" PolynomialQualificationCheck
test $(cat "$output/host/meaning/execution.exit") = 0
rg -x -F 'PASS Explorer polynomial qualification' "$output/host/meaning/result.txt"

printf '\033[36mACTION\033[0m reject actual source span/category mutations on the host\n'
for name in span category {
  cp -R "$output/source" "$output/$name-mutant/source"
  if (name === 'span') {
    sed 's/Characters offset ending/Characters (S offset) ending/g' \
      "$output/source/AlgebraicExpression.idric" > "$output/$name-mutant/source/AlgebraicExpression.idric"
  } else {
    sed 's/\[\] ⇒ Left (LocatedError ScientificExponentDigitsRequired/[] ⇒ Left (LocatedError DecimalPointDigitsRequired/' \
      "$output/source/AlgebraicExpression.idric" > "$output/$name-mutant/source/AlgebraicExpression.idric"
  }
  if cmp -s "$output/source/AlgebraicExpression.idric" "$output/$name-mutant/source/AlgebraicExpression.idric" {
    echo 'FAIL source mutant unchanged' >&2; exit 1
  }
  host_program "$output/$name-mutant/source" "$output/$name-mutant/host" SpanCheck
  test $(cat "$output/$name-mutant/host/execution.exit") = 1
  rg '^FAIL ' "$output/$name-mutant/host/result.txt"
}

printf '\033[36mACTION\033[0m emit the actual located semantic paths through checked DEX\n'
try {
  "$scheme" --program "$driver" --cg dex --directive managed-exports \
    --source-dir "$output/source" --build-dir "$output/dex/build" --output-dir "$output/dex" \
    "$output/source/SpanExports.idric" -o candidate > "$output/dex/compiler.txt" 2>&1
}
var emitted = _error.code
cat "$output/dex/compiler.txt"
printf '%s\n' "$emitted" > "$output/dex/compiler.exit"
if (emitted !== 0) { echo 'FAIL located source-to-DEX' >&2; exit 1 }
diagnostics "$output/dex/compiler.txt"
test -s "$output/dex/candidate.dex"
java -jar "$baksmali" disassemble "$output/dex/candidate.dex" -o "$output/dex/decoded"
for name in spanned_tokens detailed_syntax located_preparation {
  rg -x -F ".method public static $name(Ljava/lang/String;)Ljava/lang/String;" "$output/dex/decoded/Idric/Generated.smali"
}
java -jar "$smali" assemble "$output/dex/decoded" -o "$output/dex/roundtrip.dex"
java -jar "$smali" assemble "$repository/examples/autogenerated/spanned-formula/SpannedFormulaRunner.smali" -o "$output/observer.dex"
java -jar "$baksmali" disassemble "$output/observer.dex" -o "$output/observer-decoded"
sha256sum "$output/dex/candidate.dex" "$output/dex/roundtrip.dex" "$output/observer.dex" > "$output/artifacts.sha256"
printf 'spanned_tokens_and_typed_errors_host\tPASS\nlegacy_parser_and_semantic_host\tPASS\nsource_span_mutant_rejected\tPASS\nsource_category_mutant_rejected\tPASS\nlocated_semantic_source_to_DEX\tPASS\nindependent_decode_reassembly\tPASS\nlocated_Activity_error_ART\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m located source admission and checked DEX structure; ART separate\n'
