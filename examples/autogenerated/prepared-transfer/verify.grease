#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'usage: grease verify.grease EXPLORER FRONTEND ANDROID_NDK FRESH_OUTPUT BAKSMALI SMALI' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var android = ARGV[2]
var output = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused prepared-transfer output' >&2; exit 1 }
command -v rg
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test $(git -C "$android" rev-parse HEAD) = dfcf2cb22c0ebcc4ce999189cc2f066593bf3689
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var example = "$repository/examples/autogenerated/prepared-transfer"
var driver = "$android/dex/idric/build/exec/idric-dex"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$android/dex/idric/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
mkdir -p "$output/source" "$output/positive" "$output/repeat" \
  "$output/coefficient-mutant/source" "$output/axis-mutant/source" "$output/binding-mutant/source"
for module in AlgebraicExpression.idric PolynomialQualification.idric \
  CoefficientArithmetic.idr CoefficientValue.idric PreparedFormula.idric \
  OrderedExpansion.idric PreparedSurfaceTransfer.idric {
  cp "$repository/c-lua/idric/$module" "$output/source/"
}
cp "$example/TransferExports.idric" "$output/source/"
cp "$example/prepared-jni.tsv" "$output/prepared-jni.tsv"
printf 'explorer\t%s\nfrontend\t%s\nbackend\t%s\n' \
  $(git -C "$repository" rev-parse HEAD) $(git -C "$frontend" rev-parse HEAD) \
  $(git -C "$android" rev-parse HEAD) > "$output/inputs.tsv"
sha256sum "$output/source/AlgebraicExpression.idric" "$output/source/PolynomialQualification.idric" \
  "$output/source/CoefficientArithmetic.idr" "$output/source/CoefficientValue.idric" \
  "$output/source/PreparedFormula.idric" "$output/source/OrderedExpansion.idric" \
  "$output/source/PreparedSurfaceTransfer.idric" "$output/source/TransferExports.idric" \
  "$output/prepared-jni.tsv" "$example/PreparedTransferRunner.smali" \
  "$repository/examples/autogenerated/copied-prepared-surface/CopiedSurfaceObserver.smali" \
  "$repository/examples/autogenerated/ordered-expansion/OriginalExpansionOracle.smali" > "$output/sources.sha256"
proc emit(source, destination) {
  try {
    "$driver" --cg dex --directive managed-exports --directive "jni-map=$output/prepared-jni.tsv" \
      --source-dir "$source" --build-dir "$destination/build" --output-dir "$destination" \
      "$source/TransferExports.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { echo 'FAIL actual prepared-transfer source compilation' >&2; exit 1 }
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$destination/compiler.txt" }
  var diagnostics = _error.code
  if (diagnostics === 0) { echo 'FAIL prepared-transfer compiler reported an error' >&2; exit 1 }
  if (diagnostics !== 1) { echo 'FAIL prepared-transfer diagnostic checker' >&2; exit 1 }
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$output/source" "$output/positive"
emit "$output/source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
var decoded = "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static actual_prepare_handle(Ljava/lang/String;)J' "$decoded"
rg -x -F '.method public static actual_prepare_bound_handle(Ljava/lang/String;)J' "$decoded"
rg -x -F '.method public static actual_prepare_bound_error(Ljava/lang/String;)Ljava/lang/String;' "$decoded"
rg -x -F '.method public static native copyPreparedSurface(IIIIIII[D[I)J' "$decoded"
rg -x -F '.method public static native replacePreparedSurface(JIIIIIII[D[I)J' "$decoded"
rg -x -F '.method public static native releasePreparedSurface(J)I' "$decoded"
rg -F 'Ljava/nio/DoubleBuffer;->put(ID)Ljava/nio/DoubleBuffer;' "$decoded"
rg -F 'Ljava/nio/DoubleBuffer;->array()[D' "$decoded"
rg -F 'Ljava/nio/IntBuffer;->array()[I' "$decoded"
for mutant in coefficient-mutant axis-mutant binding-mutant {
  for module in AlgebraicExpression.idric PolynomialQualification.idric \
    CoefficientArithmetic.idr CoefficientValue.idric PreparedFormula.idric OrderedExpansion.idric TransferExports.idric {
    cp "$output/source/$module" "$output/$mutant/source/"
  }
}
sed 's/write_coefficient coefficients index term.coefficient/write_coefficient coefficients index (term.coefficient + 1.0)/' \
  "$output/source/PreparedSurfaceTransfer.idric" > "$output/coefficient-mutant/source/PreparedSurfaceTransfer.idric"
sed 's/fill_polynomial coefficients exponents surface_end surface.gradient_x.terms/fill_polynomial coefficients exponents surface_end surface.gradient_y.terms/' \
  "$output/source/PreparedSurfaceTransfer.idric" > "$output/axis-mutant/source/PreparedSurfaceTransfer.idric"
cp "$output/source/PreparedSurfaceTransfer.idric" "$output/binding-mutant/source/"
sed 's/bound_parameters "radius" = Just 2.0/bound_parameters "radius" = Just 3.0/' \
  "$output/source/TransferExports.idric" > "$output/binding-mutant/source/TransferExports.idric"
for mutant in coefficient-mutant axis-mutant binding-mutant {
  var changed_source = 'PreparedSurfaceTransfer.idric'
  if (mutant === 'binding-mutant') { setvar changed_source = 'TransferExports.idric' }
  try { cmp -s "$output/source/$changed_source" "$output/$mutant/source/$changed_source" }
  var source_status = _error.code
  if (source_status !== 1) { echo "FAIL prepared-transfer source mutant comparison: $mutant" >&2; exit 1 }
  emit "$output/$mutant/source" "$output/$mutant"
  try { cmp -s "$output/positive/candidate.dex" "$output/$mutant/candidate.dex" }
  var candidate_status = _error.code
  if (candidate_status !== 1) { echo "FAIL prepared-transfer candidate mutant comparison: $mutant" >&2; exit 1 }
}
java -jar "$smali" assemble "$example/PreparedTransferRunner.smali" \
  "$repository/examples/autogenerated/copied-prepared-surface/CopiedSurfaceObserver.smali" \
  "$repository/examples/autogenerated/ordered-expansion/OriginalExpansionOracle.smali" -o "$output/runner.dex"
java -jar "$baksmali" disassemble "$output/runner.dex" -o "$output/runner-decoded"
rg -x -F '.method public static native copyCalls()J' "$output/runner-decoded/CopiedSurfaceObserver.smali"
sha256sum "$output/positive/candidate.dex" "$output/coefficient-mutant/candidate.dex" \
  "$output/axis-mutant/candidate.dex" "$output/binding-mutant/candidate.dex" \
  "$output/runner.dex" > "$output/candidates.sha256"
printf '\033[32mPASS\033[0m actual prepared-transfer emission, independent decode and deterministic repeat; native/ART separate\n'
