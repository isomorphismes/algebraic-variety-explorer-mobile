#!/usr/bin/env grease
if (len(ARGV) !== 5) {
  echo 'usage: grease verify.grease EXPLORER FRONTEND ANDROID_NDK FRESH_OUTPUT BAKSMALI' >&2
  exit 2
}
var repository = ARGV[0]
var frontend = ARGV[1]
var android = ARGV[2]
var output = ARGV[3]
var baksmali = ARGV[4]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused semantic-preparation output' >&2; exit 1 }
command -v rg
test $(git -C "$frontend" rev-parse HEAD) = 740bbf2b1d9e811fd00c719c3473eede17ceea3b
test $(git -C "$android" rev-parse HEAD) = 682515f1c90c77b509940f90a696965d6139b5bd
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
var compiler = "$frontend/_/build/exec/idris2"
var backend = "$android/dex/idric"
var driver = "$backend/build/exec/idric-dex"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$backend/build/ttc"
setglobal ENV.IDRIS2_DATA = "$frontend/_/support"
setglobal ENV.IDRIS2_LIBS = "$frontend/_/support/c"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
mkdir -p "$output/source" "$output/check" "$output/positive" "$output/repeat" \
  "$output/mutant-fold/source" "$output/mutant-derivative/source"
cp "$repository/c-lua/idric/AlgebraicExpression.idric" "$output/source/"
cp "$repository/c-lua/idric/PolynomialQualification.idric" "$output/source/"
cp "$repository/c-lua/idric/CoefficientArithmetic.idr" "$output/source/"
cp "$repository/c-lua/idric/CoefficientValue.idric" "$output/source/"
cp "$repository/c-lua/idric/PreparedFormula.idric" "$output/source/"
cp "$repository/examples/autogenerated/semantic-preparation/PreparationExports.idric" "$output/source/"
printf 'explorer\t%s\nfrontend\t%s\nbackend\t%s\n' \
  $(git -C "$repository" rev-parse HEAD) $(git -C "$frontend" rev-parse HEAD) \
  $(git -C "$android" rev-parse HEAD) > "$output/inputs.tsv"
sha256sum "$output/source/AlgebraicExpression.idric" "$output/source/PolynomialQualification.idric" \
  "$output/source/CoefficientArithmetic.idr" "$output/source/CoefficientValue.idric" \
  "$output/source/PreparedFormula.idric" "$output/source/PreparationExports.idric" > "$output/sources.sha256"

proc clean_diagnostics(log) {
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$log" }
  var status = _error.code
  if (status === 0) { echo 'FAIL semantic-preparation compiler diagnostic' >&2; exit 1 }
  if (status !== 1) { echo 'FAIL semantic-preparation diagnostic checker' >&2; exit 1 }
}
try {
  "$compiler" --check --source-dir "$output/source" --build-dir "$output/check/build" \
    "$output/source/PreparationExports.idric" > "$output/check/compiler.txt" 2>&1
}
var check_status = _error.code
cat "$output/check/compiler.txt"
printf '%s\n' "$check_status" > "$output/check/compiler.exit"
if (check_status !== 0) { echo 'FAIL checked semantic-preparation source' >&2; exit 1 }
clean_diagnostics "$output/check/compiler.txt"

proc emit(source, destination) {
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$source" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$source/PreparationExports.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { echo 'FAIL semantic-preparation source-to-DEX' >&2; exit 1 }
  clean_diagnostics "$destination/compiler.txt"
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$output/source" "$output/positive"
emit "$output/source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -x -F '.method public static preparation_report(Ljava/lang/String;)Ljava/lang/String;' "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static bound_preparation_report(Ljava/lang/String;)Ljava/lang/String;' "$output/positive/decoded/Idric/Generated.smali"
rg '^[[:space:]]+int-to-double ' "$output/positive/decoded/Idric/Generated.smali"
proc copy_source(destination) {
  cp "$output/source/AlgebraicExpression.idric" "$output/source/PolynomialQualification.idric" \
    "$output/source/CoefficientArithmetic.idr" "$output/source/CoefficientValue.idric" \
    "$output/source/PreparedFormula.idric" "$output/source/PreparationExports.idric" "$destination/"
}
copy_source "$output/mutant-fold/source"
copy_source "$output/mutant-derivative/source"
# The original polynomial visitor reclassifies to a scalar calculation without
# immediately folding it. This mutant performs the forbidden eager revisit.
sed 's/  PreparedScalarValue (CoefficientCalculationValue operation left right)/  PreparedScalarValue (simplify_scalar (\\name ⇒ Nothing) (CoefficientCalculationValue operation left right))/' \
  "$output/source/PreparedFormula.idric" > "$output/mutant-fold/source/PreparedFormula.idric"
# Deliberately omit differentiation of the right product operand.
sed 's/(PreparedProduct left (differentiate coordinate right))/(PreparedProduct left right)/' \
  "$output/source/PreparedFormula.idric" > "$output/mutant-derivative/source/PreparedFormula.idric"
if cmp -s "$output/source/PreparedFormula.idric" "$output/mutant-fold/source/PreparedFormula.idric" {
  echo 'FAIL unchanged eager-fold mutant' >&2; exit 1
}
if cmp -s "$output/source/PreparedFormula.idric" "$output/mutant-derivative/source/PreparedFormula.idric" {
  echo 'FAIL unchanged product-rule mutant' >&2; exit 1
}
emit "$output/mutant-fold/source" "$output/mutant-fold"
emit "$output/mutant-derivative/source" "$output/mutant-derivative"
if cmp -s "$output/positive/candidate.dex" "$output/mutant-fold/candidate.dex" {
  echo 'FAIL eager-fold mutant produced unchanged bytes' >&2; exit 1
}
if cmp -s "$output/positive/candidate.dex" "$output/mutant-derivative/candidate.dex" {
  echo 'FAIL product-rule mutant produced unchanged bytes' >&2; exit 1
}
sha256sum "$output/positive/candidate.dex" "$output/mutant-fold/candidate.dex" \
  "$output/mutant-derivative/candidate.dex" > "$output/candidates.sha256"
printf '\033[32mPASS\033[0m semantic-preparation source, direct DEX, decode and determinism; ART separate\n'
