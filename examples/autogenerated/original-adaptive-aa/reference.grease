#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) {
  echo 'usage: grease reference.grease REPOSITORY LOCKED_JAR_DIRECTORY FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var dependencies = ARGV[1]
var output = ARGV[2]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused original-AA reference output' >&2; exit 1 }
command -v javac > /dev/null
command -v java > /dev/null
command -v rg > /dev/null
command -v tar > /dev/null
var baseline = 'cfd543e1886bc6b7eb9e1ede6641569b673aac8d'
git -C "$repository" cat-file -e "$baseline^{commit}"
var antlr = "$dependencies/antlr-runtime-3.4.jar"
var vecmath = "$dependencies/vecmath-1.5.2.jar"
printf '%s  %s\n' 5b7cf53b7b30b034023f58030c8147c433f2bee0fe7dec8fae6bebf3708c5a63 "$antlr" | sha256sum -c -
printf '%s  %s\n' 3558e81ca74c60dc01baca7ef05f48594bbaed43af45d4f1b9196e479734e675 "$vecmath" | sha256sum -c -
mkdir -p "$output/classes" "$output/repeat" "$output/original-source"
git -C "$repository" rev-parse HEAD > "$output/candidate-source-revision.txt"
git -C "$repository" rev-parse "$baseline^{commit}" > "$output/original-source-revision.txt"
git -C "$repository" archive --format=tar "$baseline" -- '*.java' | tar -xf - -C "$output/original-source"
printf '%s  %s\n' 04c31acb0f67fa24cdc884e852a64986f633aa056a1355d8e80bb90ea2698ec6 "$output/original-source/AntiAliasingPattern.java" | sha256sum -c -
printf '%s  %s\n' baf98e09dd9794df896d6fc53320bfd6032c60e63cdf6e3975d4a192d2c95eb4 "$output/original-source/RenderingTask.java" | sha256sum -c -
printf '%s  %s\n' 979b3a57e0055e809b54abe41c6b98363ac57a3c3199ba16a0587c4bc3f43688 "$output/original-source/CPUAlgebraicSurfaceRenderer.java" | sha256sum -c -
printf '%s  %s\n' b21abd24ed2d21868322c314808a3533c53b29565742426e26a3423d105beff9 "$output/original-source/ColorInt.java" | sha256sum -c -
javac --version > "$output/javac-version.txt" 2>&1
java -XX:-UsePerfData -version > "$output/java-version.txt" 2>&1
printf 'role\toriginal-jsurf-test-only\nsource_target\tJava17\nFP\tJava17-strict-F32-F64\nJVM_flags\t-XX:-UsePerfData\nexecution\tone-original-full-canvas-RenderingTask\nworker_partition_parity\tNOT_ESTABLISHED\n' > "$output/profile.tsv"
cd "$output/original-source"
# Only inherited root jsurf packages from the immutable public baseline are
# compiled. Candidate Java/C and Android application classes cannot enter this
# oracle compilation; only the separate current test adapter is added below.
rg -l '^package de[.]mfo[.]jsurf[.]' --glob '*.java' --maxdepth 1 . | LC_ALL=C sort > "$output/original-sources.txt"
xargs sha256sum < "$output/original-sources.txt" > "$output/original-sources.sha256"
var harness = "$repository/examples/autogenerated/original-adaptive-aa/OriginalAdaptiveAAOracle.java"
sha256sum "$harness" "$antlr" "$vecmath" > "$output/harness-and-dependencies.sha256"
javac --release 17 -cp "$antlr:$vecmath" -d "$output/classes" \
  "@$output/original-sources.txt" "$harness" > "$output/compiler.txt" 2>&1
test -s "$output/classes/de/mfo/jsurf/rendering/cpu/OriginalAdaptiveAAOracle.class"
for mode in patterns blends pixels {
  java -XX:-UsePerfData -cp "$output/classes:$antlr:$vecmath" \
    de.mfo.jsurf.rendering.cpu.OriginalAdaptiveAAOracle "$mode" \
    > "$output/$mode.tsv" 2> "$output/$mode.stderr"
  java -XX:-UsePerfData -cp "$output/classes:$antlr:$vecmath" \
    de.mfo.jsurf.rendering.cpu.OriginalAdaptiveAAOracle "$mode" \
    > "$output/repeat/$mode.tsv" 2> "$output/repeat/$mode.stderr"
  test ! -s "$output/$mode.stderr"
  test ! -s "$output/repeat/$mode.stderr"
  cmp "$output/$mode.tsv" "$output/repeat/$mode.tsv"
}
test $(wc -l < "$output/patterns.tsv") = 6
test $(wc -l < "$output/blends.tsv") = 15
test $(wc -l < "$output/pixels.tsv") = 691
test $(rg -c '^frame\t' "$output/pixels.tsv") = 9
test $(rg -c '^pixel\t' "$output/pixels.tsv") = 682
rg '^blend\tuniform\t3e99999a\t0\t' "$output/blends.tsv"
rg '^blend\tuniform-force\t00000000\t1\t' "$output/blends.tsv"
rg '^blend\tbelow-threshold\t3e99999a\t0\t' "$output/blends.tsv"
rg '^blend\texact-threshold\t3e99999a\t1\t' "$output/blends.tsv"
rg '^blend\tsmooth-float-order\t3e99999a\t0\t' "$output/blends.tsv"
sha256sum "$output/patterns.tsv" "$output/blends.tsv" "$output/pixels.tsv" > "$output/reference-output.sha256"
printf 'original_source_hashes\tPASS\noriginal_Java17_source_compile\tPASS\nactual_RenderingTask_AA\tPASS\nreference_repeat_bytes\tPASS\npatterns\t6\nblend_cases\t15\nframes\t9\npixels\t682\ncandidate_C\tNOT_RUN\nAndroid\tNOT_RUN\nphysical_devices\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m original full-canvas Java AA reference; candidate C qualification separate\n'
