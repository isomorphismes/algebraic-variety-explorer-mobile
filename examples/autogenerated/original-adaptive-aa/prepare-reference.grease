#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 2) { echo 'usage: grease prepare-reference.grease REPOSITORY FRESH_JARS' >&2; exit 2 }
var repository = ARGV[0]
var output = ARGV[1]
if (repository[0] !== '/' or output[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
if test -e "$output" { echo 'FAIL refusing reused reference dependencies' >&2; exit 1 }
var grease = $(command -v grease)
mkdir -p "$output"
# Share the source-reference acquisition path: it verifies cached bytes, tries
# both declared Maven Central endpoints, and keeps the same locked digests.
"$grease" "$repository/examples/autogenerated/polynomial-qualification/prepare-dependencies.grease" \
  "$repository" "$output/acquisition"
cp "$output/acquisition/antlr-runtime-3.4.jar" "$output/antlr-runtime-3.4.jar"
cp "$output/acquisition/vecmath-1.5.2.jar" "$output/vecmath-1.5.2.jar"
printf '%s  %s\n' 5b7cf53b7b30b034023f58030c8147c433f2bee0fe7dec8fae6bebf3708c5a63 "$output/antlr-runtime-3.4.jar" | sha256sum -c -
printf '%s  %s\n' 3558e81ca74c60dc01baca7ef05f48594bbaed43af45d4f1b9196e479734e675 "$output/vecmath-1.5.2.jar" | sha256sum -c -
sha256sum "$repository/dependencies.lock" "$output/antlr-runtime-3.4.jar" "$output/vecmath-1.5.2.jar" > "$output/dependencies.sha256"
