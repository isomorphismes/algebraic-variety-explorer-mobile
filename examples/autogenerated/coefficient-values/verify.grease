#!/usr/bin/env grease
# Qualify the actual scalar producer, without a generic numeric Show/cast probe.
if (len(ARGV) !== 5) { echo 'usage: grease verify.grease EXPLORER FRONTEND ANDROID_NDK FRESH_OUTPUT BAKSMALI' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var android = ARGV[2]
var output = ARGV[3]
var baksmali = ARGV[4]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused coefficient output' >&2; exit 1 }
command -v rg
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
var driver = "$android/dex/idric/build/exec/idric-dex"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$android/dex/idric/build/ttc"
mkdir -p "$output/source" "$output/positive" "$output/repeat" "$output/mutant/source"
cp "$repository/c-lua/idric/AlgebraicExpression.idric" \
  "$repository/c-lua/idric/PolynomialQualification.idric" \
  "$repository/c-lua/idric/CoefficientArithmetic.idr" \
  "$repository/c-lua/idric/CoefficientValue.idric" \
  "$repository/examples/autogenerated/coefficient-values/CoefficientExports.idric" "$output/source/"
printf 'explorer\t%s\nfrontend\t%s\nbackend\t%s\n' \
  $(git -C "$repository" rev-parse HEAD) $(git -C "$frontend" rev-parse HEAD) \
  $(git -C "$android" rev-parse HEAD) > "$output/inputs.tsv"
sha256sum "$output/source/AlgebraicExpression.idric" "$output/source/PolynomialQualification.idric" \
  "$output/source/CoefficientArithmetic.idr" "$output/source/CoefficientValue.idric" \
  "$output/source/CoefficientExports.idric" > "$output/sources.sha256"
proc emit(source, destination) {
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$source" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$source/CoefficientExports.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { echo 'FAIL actual coefficient source compilation' >&2; exit 1 }
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$destination/compiler.txt" }
  var diagnostics = _error.code
  if (diagnostics === 0) { echo 'FAIL coefficient compiler reported an error' >&2; exit 1 }
  if (diagnostics !== 1) { echo 'FAIL coefficient diagnostic checker' >&2; exit 1 }
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$output/source" "$output/positive"
emit "$output/source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -x -F '.method public static coefficient_bits(Ljava/lang/String;)Ljava/lang/String;' \
  "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/lang/Double;->parseDouble(Ljava/lang/String;)D' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/lang/Double;->doubleToLongBits(D)J' "$output/positive/decoded/Idric/Generated.smali"
rg -F 'Ljava/lang/Math;->pow(DD)D' "$output/positive/decoded/Idric/Generated.smali"
cp "$output/source/AlgebraicExpression.idric" "$output/source/PolynomialQualification.idric" \
  "$output/source/CoefficientArithmetic.idr" "$output/source/CoefficientExports.idric" "$output/mutant/source/"
# Change the real sum implementation. The observer must catch its changed value.
sed 's/Right (first + second)/Right (subtract_coefficients first second)/' \
  "$output/source/CoefficientValue.idric" > "$output/mutant/source/CoefficientValue.idric"
if cmp -s "$output/source/CoefficientValue.idric" "$output/mutant/source/CoefficientValue.idric" {
  echo 'FAIL unchanged coefficient source mutant' >&2; exit 1
}
emit "$output/mutant/source" "$output/mutant"
if cmp -s "$output/positive/candidate.dex" "$output/mutant/candidate.dex" {
  echo 'FAIL coefficient source mutation produced unchanged DEX' >&2; exit 1
}
sha256sum "$output/positive/candidate.dex" "$output/mutant/candidate.dex" > "$output/candidates.sha256"
printf '\033[32mPASS\033[0m actual coefficient source emission, independent decode and determinism; ART separate\n'
