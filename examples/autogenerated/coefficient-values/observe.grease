#!/usr/bin/env grease
if (len(ARGV) !== 5) { echo 'usage: grease observe.grease ADB SERIAL EVIDENCE RUNNER ORIGINAL_ORACLE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var evidence = ARGV[2]
var runner = ARGV[3]
var oracle = ARGV[4]
if (adb[0] !== '/' or evidence[0] !== '/' or runner[0] !== '/' or oracle[0] !== '/') {
  echo 'FAIL absolute paths required' >&2; exit 2
}
var remote = '/data/local/tmp/ave-coefficient-values'
"$adb" -s "$serial" shell rm -rf "$remote"
"$adb" -s "$serial" shell mkdir "$remote"
"$adb" -s "$serial" push "$runner" "$remote/runner.dex"
"$adb" -s "$serial" push "$oracle" "$remote/original-oracle.dex"
"$adb" -s "$serial" push "$evidence/positive/candidate.dex" "$remote/positive.dex"
"$adb" -s "$serial" push "$evidence/mutant/candidate.dex" "$remote/mutant.dex"
"$adb" -s "$serial" shell chmod 444 "$remote/runner.dex" "$remote/positive.dex" "$remote/mutant.dex" "$remote/original-oracle.dex"
"$adb" -s "$serial" pull "$remote/runner.dex" "$evidence/runner-received.dex"
"$adb" -s "$serial" pull "$remote/positive.dex" "$evidence/positive-received.dex"
"$adb" -s "$serial" pull "$remote/mutant.dex" "$evidence/mutant-received.dex"
"$adb" -s "$serial" pull "$remote/original-oracle.dex" "$evidence/original-oracle-received.dex"
cmp "$runner" "$evidence/runner-received.dex"
cmp "$evidence/positive/candidate.dex" "$evidence/positive-received.dex"
cmp "$evidence/mutant/candidate.dex" "$evidence/mutant-received.dex"
cmp "$oracle" "$evidence/original-oracle-received.dex"
"$adb" -s "$serial" shell "CLASSPATH=$remote/positive.dex:$remote/original-oracle.dex:$remote/runner.dex app_process /system/bin CoefficientRunner" \
  > "$evidence/art-positive.txt" 2>&1
cat "$evidence/art-positive.txt"
rg -x -F 'PASS Explorer coefficient values on ART' "$evidence/art-positive.txt"
try {
  "$adb" -s "$serial" shell "CLASSPATH=$remote/mutant.dex:$remote/original-oracle.dex:$remote/runner.dex app_process /system/bin CoefficientRunner" \
    > "$evidence/art-mutant.txt" 2>&1
}
var status = _error.code
cat "$evidence/art-mutant.txt"
if (status !== 76) { echo 'FAIL missing designated coefficient mutant rejection' >&2; exit 1 }
rg -x -F 'FAIL Explorer coefficient value' "$evidence/art-mutant.txt"
"$adb" -s "$serial" shell getprop ro.build.version.sdk > "$evidence/art-sdk.txt"
"$adb" -s "$serial" shell getprop ro.product.cpu.abi > "$evidence/art-abi.txt"
printf 'scalar_coefficient_ART\tPASS\noriginal_jsurf_value_bits\tPASS\ncompiled_coefficient_mutant_rejected\tPASS\npositive_parameter_bindings\tNOT_RUN\npolynomial_expansion\tNOT_RUN\nAPK\tNOT_RUN\nphysical_C67\tNOT_RUN\nphysical_A1\tNOT_RUN\n' > "$evidence/art-result.tsv"
printf '\033[32mPASS\033[0m actual Explorer coefficient values and compiled source mutation on ART\n'
