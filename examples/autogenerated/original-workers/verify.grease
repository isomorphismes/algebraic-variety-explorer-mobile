#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease verify.grease EXPLORER ICK_SOURCE QUALIFIED_ICK ORIGINAL_REFERENCE FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var ick_source = ARGV[1]
var compiler = ARGV[2]
var reference = ARGV[3]
var output = ARGV[4]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused original-worker evidence' >&2; exit 1 }
test $(git -C "$ick_source" rev-parse HEAD) = fbe86e23d55cfec2000c08e61deea2a407fd7175
test -x "$compiler"
command -v rg > /dev/null
command -v nm > /dev/null
rg -x -F b'actual_processor_count_tile_profiles_1_2_4_8\tPASS' "$reference/result.tsv"
rg -x -F b'actual_serial_draw_matches_ordered_tiles\tPASS' "$reference/result.tsv"
var manifest = "$repository/ci/native-workers-toolchain.tsv"
rg -x -F b'build_id\ttarget\ttoolchain\tick_revision\tick_status\tick_evidence' "$manifest"
for stage in numerical row-copy-mutant epoch-mutant pool-mutant publication-mutant sanitizers {
  printf 'native-workers-%s\tx86_64-pc-linux-gnu\tick\tfbe86e23d55cfec2000c08e61deea2a407fd7175\tqualified\treceipt:ai-ci-ick-host-32cb45b3\n' "$stage" | rg -x -F -f - "$manifest"
}
test $(wc -l < "$manifest") = 7
mkdir -p "$output/mutants"
"$compiler" --version > "$output/ick-version.txt"
"$compiler" -dumpmachine > "$output/ick-target.txt"
rg -x -F x86_64-pc-linux-gnu "$output/ick-target.txt"
var cc1 = $("$compiler" -print-prog-name=cc1)
test -x "$cc1"
sha256sum "$compiler" "$cc1" > "$output/toolchain.sha256"
sha256sum "$repository/native/surfer_render_session.c" "$repository/native/surfer_render_session.h" \
  "$repository/native/surfer_original_workers.inc" "$repository/native/surfer_original_workers_test.c" \
  "$repository/native/surfer_raytracer.c" "$repository/native/surfer_raytracer.h" \
  "$repository/native/surfer_original_specialization.inc" "$repository/native/surfer_original_camera.inc" \
  "$repository/native/surfer_vecmath.c" "$repository/native/surfer_vecmath.h" \
  "$repository/native/surfer_surface_store.c" "$repository/native/surfer_surface_store.h" \
  "$reference/ordered-workers-count-1.tsv" "$reference/ordered-workers-count-2.tsv" \
  "$reference/ordered-workers-count-4.tsv" "$reference/ordered-workers-count-8.tsv" > "$output/inputs.sha256"
cp "$reference/result.tsv" "$output/original-reference-profile.tsv"
cp "$manifest" "$output/toolchain.tsv"
git -C "$repository" rev-parse HEAD > "$output/source-revision.txt"
proc compile_workers(source, destination) {
  "$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
    -fno-fast-math -ffp-contract=off -DSURFER_RENDER_SESSION_TESTING -DSURFER_SURFACE_STORE_TESTING \
    "$repository/native/surfer_original_workers_test.c" "$source/surfer_render_session.c" \
    "$repository/native/surfer_surface_store.c" "$repository/native/surfer_raytracer.c" \
    "$repository/native/surfer_vecmath.c" -I "$repository/native" -lm -pthread -o "$destination"
}
proc run_workers(binary, log) {
  "$binary" "$reference/ordered-workers-count-1.tsv" "$reference/ordered-workers-count-2.tsv" \
    "$reference/ordered-workers-count-4.tsv" "$reference/ordered-workers-count-8.tsv" > "$log" 2>&1
}
compile_workers "$repository/native" "$output/test"
run_workers "$output/test" "$output/numerical.txt"
rg '^(processor profile|parallel |PASS)' "$output/numerical.txt"
rg -x -F 'PASS original bounded workers processor profiles cancellation faults and retained ownership' "$output/numerical.txt"
nm -u "$output/test" > "$output/undefined-symbols.txt"
try { rg '__atomic_|__sync_' "$output/undefined-symbols.txt" }
if (_error.code !== 1) { echo 'FAIL unexpected atomic runtime import or scanner failure' >&2; exit 1 }
proc reject_mutant(name, file, expression, diagnostic) {
  var destination = "$output/mutants/$name"
  mkdir -p "$destination"
  for input in surfer_render_session.c surfer_render_session.h surfer_original_workers.inc {
    cp "$repository/native/$input" "$destination/"
  }
  sed "$expression" "$repository/native/$file" > "$destination/changed"
  try { cmp -s "$repository/native/$file" "$destination/changed" }
  if (_error.code !== 1) { echo 'FAIL worker mutation unchanged' >&2; exit 1 }
  mv "$destination/changed" "$destination/$file"
  compile_workers "$destination" "$destination/test"
  try { run_workers "$destination/test" "$destination/result.txt" }
  if (_error.code !== 1) { echo "FAIL missing designated worker mutation rejection: $name" >&2; exit 1 }
  rg '^(pixel|FAIL)' "$destination/result.txt"
  rg -F "$diagnostic" "$destination/result.txt"
}
reject_mutant row-copy surfer_original_workers.inc 's/worker->pixels\[(y - y_start) \* tile_width\]/worker->pixels[0 * (y - y_start) * tile_width]/' \
  'exact actual original ordered worker pixels'
reject_mutant epoch surfer_original_workers.inc 's/queue->stopped || (queue->cancellation != NULL/queue->stopped || (false \&\& queue->cancellation != NULL/' \
  'cancelled four-worker frame committed work or published'
reject_mutant pool surfer_render_session.c 's/session->worker_limit, width/(processors < 4 ? processors : 4), width/' \
  'numerical workers failed to reach real concurrency barrier'
reject_mutant publication surfer_render_session.c 's/if (!publish_current) status = SURFER_CANCELLED;/if (false \&\& !publish_current) status = SURFER_CANCELLED;/' \
  'joined stale worker frame reached publisher'
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O1 -g \
  -fno-fast-math -ffp-contract=off -fsanitize=address,undefined -fno-omit-frame-pointer \
  -DSURFER_RENDER_SESSION_TESTING -DSURFER_SURFACE_STORE_TESTING \
  "$repository/native/surfer_original_workers_test.c" "$repository/native/surfer_render_session.c" \
  "$repository/native/surfer_surface_store.c" "$repository/native/surfer_raytracer.c" \
  "$repository/native/surfer_vecmath.c" -lm -pthread -o "$output/sanitized"
env ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1 \
  "$output/sanitized" "$reference/ordered-workers-count-1.tsv" "$reference/ordered-workers-count-2.tsv" \
  "$reference/ordered-workers-count-4.tsv" "$reference/ordered-workers-count-8.tsv" > "$output/sanitizers.txt" 2>&1
rg '^(processor profile|parallel |PASS)' "$output/sanitizers.txt"
rg -x -F 'PASS original bounded workers processor profiles cancellation faults and retained ownership' "$output/sanitizers.txt"
sha256sum "$output/test" "$output/sanitized" > "$output/binaries.sha256"
sha256sum "$output/numerical.txt" "$output/sanitizers.txt" > "$output/decoded-argb.sha256"
printf 'processor_profiles\t1,2,4,8\nexact_original_frames\t176\nexact_original_pixels\t21648\npublic_and_instrumented_entries\tPASS\nreal_four_worker_barrier\tPASS\nimmutable_creation_pool\tPASS\nall_owner_buffer_faults\tPASS\nthread_start_failures\tPASS\nactive_cancel_begin_close_and_surface_release\tPASS\njoined_frame_currentness\tPASS\nfour_compiled_mutants\tPASS\nASAN_UBSAN_leaks\tPASS\nAndroid\tNOT_RUN\nphysical_devices\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m original bounded workers and retained publication; Android qualification separate\n'
