#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease reference.grease EXPLORER LOCKED_JAR_DIRECTORY FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var dependencies = ARGV[1]
var output = ARGV[2]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute original-reference paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused specialization reference' >&2; exit 1 }
command -v javac > /dev/null
command -v java > /dev/null
command -v rg > /dev/null
var baseline = 'cfd543e1886bc6b7eb9e1ede6641569b673aac8d'
git -C "$repository" cat-file -e "$baseline^{commit}"
var antlr = "$dependencies/antlr-runtime-3.4.jar"
var vecmath = "$dependencies/vecmath-1.5.2.jar"
printf '%s  %s\n' 5b7cf53b7b30b034023f58030c8147c433f2bee0fe7dec8fae6bebf3708c5a63 "$antlr" | sha256sum -c -
printf '%s  %s\n' 3558e81ca74c60dc01baca7ef05f48594bbaed43af45d4f1b9196e479734e675 "$vecmath" | sha256sum -c -
mkdir -p "$output/classes" "$output/original-source"
git -C "$repository" rev-parse HEAD > "$output/candidate-source-revision.txt"
git -C "$repository" rev-parse "$baseline^{commit}" > "$output/original-source-revision.txt"
git -C "$repository" archive --format=tar "$baseline" -- '*.java' | tar -xf - -C "$output/original-source"
proc verify(file, digest) {
  printf '%s  %s\n' "$digest" "$output/original-source/$file" | sha256sum -c -
}
verify XYZPolynomial.java 7074d0d6e0d22fb2c70aaee62130c7beb0c033b9725da97a15d026cf95bf1496
verify XYPolynomial.java 99d5f88a18db8eb61a88150593a50d4680539b3a06f0262d18ad1c723a1ca5c9
verify UnivariatePolynomial.java 2aec3b9bc14a3dbf28a8d2cac0dece090632a60ba4daf81443711d2cd4af7a72
verify Expand.java 0185b4a6d712b857633edf8f2b0ce818778467e919b343e8a046dcf7ed9a9e9b
verify Differentiator.java fc866d627e5c8ec85ac4b9e0f80506e525477537affc7cf8bbd84f4badf1d6ca
verify TransformedPolynomialRowSubstitutor.java 4a2e824dcf10b96c081706a16dea105f8a7a37f0cbe5b78f8550d24b335e2eb4
verify TransformedPolynomialRowSubstitutorForGradient.java 9305182d6cc49b2ae58779a191855353f13437f9c461a8afa45affe5a40c3a1e
javac --version > "$output/javac-version.txt" 2>&1
rg '^javac 17[.]' "$output/javac-version.txt"
java -XX:-UsePerfData -version > "$output/java-version.txt" 2>&1
cd "$output/original-source"
rg -l '^package de[.]mfo[.]jsurf[.]' --glob '*.java' --maxdepth 1 . | LC_ALL=C sort > "$output/original-sources.txt"
xargs sha256sum < "$output/original-sources.txt" > "$output/original-sources.sha256"
var harness = "$repository/examples/autogenerated/original-specialization/OriginalSpecializationOracle.java"
sha256sum "$harness" "$antlr" "$vecmath" > "$output/adapter-and-dependencies.sha256"
javac --release 17 -cp "$antlr:$vecmath" -d "$output/classes" \
  "@$output/original-sources.txt" "$harness" > "$output/compiler.txt" 2>&1
for name in observations repeat {
  java -XX:-UsePerfData -cp "$output/classes:$antlr:$vecmath" \
    de.mfo.jsurf.algebra.OriginalSpecializationOracle > "$output/$name.tsv" 2> "$output/$name.stderr"
  test ! -s "$output/$name.stderr"
}
cmp "$output/observations.tsv" "$output/repeat.tsv"
test $(rg -c b'^case\t' "$output/observations.tsv") = 30
test $(rg -c b'^case_end\t' "$output/observations.tsv") = 30
test $(rg -c b'^input\t' "$output/observations.tsv") = 120
test $(rg -c b'^transformed\t' "$output/observations.tsv") = 120
test $(rg -c b'^column\t' "$output/observations.tsv") = 840
test $(rg -c b'^evaluation\t' "$output/observations.tsv") = 5880
sha256sum "$output/observations.tsv" > "$output/observations.sha256"
printf 'frozen_original_source\tPASS\noriginal_Java17_compile\tPASS\nactual_XYZ_substitute_evaluateZ_XY_evaluateY\tPASS\nactual_Univariate_evaluateAt\tPASS\noriginal_derivatives\tPASS\nrepeat_bytes\tPASS\ncases\t30\ncolumns\t840\nevaluations\t5880\ncandidate_C\tNOT_RUN\nfull_camera_lighting_image_parity\tNOT_ESTABLISHED\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m actual original specialization and gradient reference; candidate qualification separate\n'
