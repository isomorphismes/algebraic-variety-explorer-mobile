#!/usr/bin/env grease
if (len(ARGV) !== 6) { echo 'usage: grease verify.grease EXPLORER FRONTEND ANDROID_NDK FRESH_OUTPUT BAKSMALI SMALI' >&2; exit 2 }
var repository = ARGV[0]
var frontend = ARGV[1]
var android = ARGV[2]
var output = ARGV[3]
var baksmali = ARGV[4]
var smali = ARGV[5]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute path required' >&2; exit 2 }
}
if test -e "$output" { echo 'FAIL refusing reused expansion output' >&2; exit 1 }
command -v rg
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
var example = "$repository/examples/autogenerated/ordered-expansion"
var driver = "$android/dex/idric/build/exec/idric-dex"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
setglobal ENV.IDRIS2_PATH = "$android/dex/idric/build/ttc"
mkdir -p "$output/source" "$output/positive" "$output/repeat" \
  "$output/kahan-mutant/source" "$output/family-mutant/source"
for module in AlgebraicExpression.idric PolynomialQualification.idric \
  CoefficientArithmetic.idr CoefficientValue.idric PreparedFormula.idric OrderedExpansion.idric {
  cp "$repository/c-lua/idric/$module" "$output/source/"
}
cp "$example/ExpansionExports.idric" "$output/source/"
printf 'explorer\t%s\nfrontend\t%s\nbackend\t%s\n' \
  $(git -C "$repository" rev-parse HEAD) $(git -C "$frontend" rev-parse HEAD) \
  $(git -C "$android" rev-parse HEAD) > "$output/inputs.tsv"
sha256sum "$output/source/OrderedExpansion.idric" "$output/source/PreparedFormula.idric" \
  "$output/source/ExpansionExports.idric" "$example/ExpansionRunner.smali" \
  "$example/OriginalExpansionOracle.smali" > "$output/sources.sha256"
proc emit(source, destination) {
  try {
    "$driver" --cg dex --directive managed-exports --source-dir "$source" \
      --build-dir "$destination/build" --output-dir "$destination" \
      "$source/ExpansionExports.idric" -o candidate > "$destination/compiler.txt" 2>&1
  }
  var status = _error.code
  cat "$destination/compiler.txt"
  printf '%s\n' "$status" > "$destination/compiler.exit"
  if (status !== 0) { echo 'FAIL actual ordered expansion compilation' >&2; exit 1 }
  try { rg -n '^[[:space:]]*(Error:|INTERNAL ERROR)' "$destination/compiler.txt" }
  var diagnostics = _error.code
  if (diagnostics === 0) { echo 'FAIL expansion compiler reported an error' >&2; exit 1 }
  if (diagnostics !== 1) { echo 'FAIL expansion diagnostic checker' >&2; exit 1 }
  test -s "$destination/candidate.dex"
  java -jar "$baksmali" disassemble "$destination/candidate.dex" -o "$destination/decoded"
}
emit "$output/source" "$output/positive"
emit "$output/source" "$output/repeat"
cmp "$output/positive/candidate.dex" "$output/repeat/candidate.dex"
rg -x -F '.method public static actual_expansion(Ljava/lang/String;)Ljava/lang/String;' \
  "$output/positive/decoded/Idric/Generated.smali"
rg -x -F '.method public static actual_expansion_with_radius(Ljava/lang/String;)Ljava/lang/String;' \
  "$output/positive/decoded/Idric/Generated.smali"
for mutant in kahan-mutant family-mutant {
  cp "$output/source/AlgebraicExpression.idric" "$output/source/PolynomialQualification.idric" \
    "$output/source/CoefficientArithmetic.idr" "$output/source/CoefficientValue.idric" \
    "$output/source/PreparedFormula.idric" "$output/source/ExpansionExports.idric" "$output/$mutant/source/"
}
sed 's/next_correction = subtract_coefficients .*/next_correction = 0.0/' \
  "$output/source/OrderedExpansion.idric" > "$output/kahan-mutant/source/OrderedExpansion.idric"
sed 's/ExpandedPreparation prepared.family_degree/ExpandedPreparation 0/' \
  "$output/source/OrderedExpansion.idric" > "$output/family-mutant/source/OrderedExpansion.idric"
for mutant in kahan-mutant family-mutant {
  try { cmp -s "$output/source/OrderedExpansion.idric" "$output/$mutant/source/OrderedExpansion.idric" }
  var source_status = _error.code
  if (source_status !== 1) { echo "FAIL expansion source mutant comparison: $mutant" >&2; exit 1 }
  emit "$output/$mutant/source" "$output/$mutant"
  try { cmp -s "$output/positive/candidate.dex" "$output/$mutant/candidate.dex" }
  var candidate_status = _error.code
  if (candidate_status !== 1) { echo "FAIL expansion candidate mutant comparison: $mutant" >&2; exit 1 }
}
java -jar "$smali" assemble "$example/ExpansionRunner.smali" "$example/OriginalExpansionOracle.smali" -o "$output/runner.dex"
sha256sum "$output/positive/candidate.dex" "$output/kahan-mutant/candidate.dex" \
  "$output/family-mutant/candidate.dex" "$output/runner.dex" > "$output/candidates.sha256"
printf '\033[32mPASS\033[0m real ordered expansion emission, independent decode and deterministic repeat; ART separate\n'
