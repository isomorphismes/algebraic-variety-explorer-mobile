#!/usr/bin/env grease
if (len(ARGV) !== 4) { echo 'usage: grease observe.grease ADB SERIAL EVIDENCE ORIGINAL_ORACLE' >&2; exit 2 }
var adb = ARGV[0]
var serial = ARGV[1]
var evidence = ARGV[2]
var oracle = ARGV[3]
if (adb[0] !== '/' or evidence[0] !== '/' or oracle[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
var remote = '/data/local/tmp/ave-ordered-expansion'
"$adb" -s "$serial" shell rm -rf "$remote"
"$adb" -s "$serial" shell mkdir "$remote"
"$adb" -s "$serial" push "$evidence/runner.dex" "$remote/runner.dex"
"$adb" -s "$serial" push "$oracle" "$remote/original-oracle.dex"
for name in positive kahan-mutant family-mutant {
  "$adb" -s "$serial" push "$evidence/$name/candidate.dex" "$remote/$name.dex"
  "$adb" -s "$serial" shell chmod 444 "$remote/$name.dex"
  "$adb" -s "$serial" pull "$remote/$name.dex" "$evidence/$name-received.dex"
  cmp "$evidence/$name/candidate.dex" "$evidence/$name-received.dex"
}
"$adb" -s "$serial" shell chmod 444 "$remote/runner.dex" "$remote/original-oracle.dex"
"$adb" -s "$serial" pull "$remote/runner.dex" "$evidence/runner-received.dex"
"$adb" -s "$serial" pull "$remote/original-oracle.dex" "$evidence/original-oracle-received.dex"
cmp "$evidence/runner.dex" "$evidence/runner-received.dex"
cmp "$oracle" "$evidence/original-oracle-received.dex"
"$adb" -s "$serial" shell "CLASSPATH=$remote/positive.dex:$remote/original-oracle.dex:$remote/runner.dex app_process /system/bin ExpansionRunner" \
  > "$evidence/art-positive.txt" 2>&1
cat "$evidence/art-positive.txt"
rg -x -F 'PASS Explorer ordered expansion on ART' "$evidence/art-positive.txt"
for mutant in kahan-mutant family-mutant {
  try {
    "$adb" -s "$serial" shell "CLASSPATH=$remote/$mutant.dex:$remote/original-oracle.dex:$remote/runner.dex app_process /system/bin ExpansionRunner" \
      > "$evidence/art-$mutant.txt" 2>&1
  }
  var status = _error.code
  cat "$evidence/art-$mutant.txt"
  if (status !== 77) { echo "FAIL missing designated ordered expansion mutant rejection: $mutant" >&2; exit 1 }
  rg -x -F 'FAIL Explorer ordered expansion' "$evidence/art-$mutant.txt"
}
"$adb" -s "$serial" shell getprop ro.build.version.sdk > "$evidence/art-sdk.txt"
"$adb" -s "$serial" shell getprop ro.product.cpu.abi > "$evidence/art-abi.txt"
printf 'ordered_expansion_ART\tPASS\noriginal_jsurf_terms_and_gradients\tPASS\ncompiled_kahan_mutant_rejected\tPASS\ncompiled_family_mutant_rejected\tPASS\nJNI_transfer\tNOT_RUN\nAPK\tNOT_RUN\nphysical_C67\tNOT_RUN\nphysical_A1\tNOT_RUN\n' > "$evidence/art-result.tsv"
printf '\033[32mPASS\033[0m actual ordered expansion and compiled source mutations on ART\n'
