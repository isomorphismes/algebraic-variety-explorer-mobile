#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 3) { echo 'usage: grease reference.grease EXPLORER LOCKED_JAR_DIRECTORY FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var dependencies = ARGV[1]
var output = ARGV[2]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute original-camera paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused original-camera evidence' >&2; exit 1 }
command -v javac > /dev/null
command -v java > /dev/null
command -v rg > /dev/null
var baseline = 'cfd543e1886bc6b7eb9e1ede6641569b673aac8d'
git -C "$repository" cat-file -e "$baseline^{commit}"
var antlr = "$dependencies/antlr-runtime-3.4.jar"
var vecmath = "$dependencies/vecmath-1.5.2.jar"
printf '%s  %s\n' 5b7cf53b7b30b034023f58030c8147c433f2bee0fe7dec8fae6bebf3708c5a63 "$antlr" | sha256sum -c -
printf '%s  %s\n' 3558e81ca74c60dc01baca7ef05f48594bbaed43af45d4f1b9196e479734e675 "$vecmath" | sha256sum -c -
mkdir -p "$output/classes" "$output/original-source"
git -C "$repository" rev-parse HEAD > "$output/candidate-source-revision.txt"
git -C "$repository" rev-parse "$baseline^{commit}" > "$output/original-source-revision.txt"
git -C "$repository" archive --format=tar "$baseline" -- '*.java' | tar -xf - -C "$output/original-source"
proc verify(file, digest) {
  printf '%s  %s\n' "$digest" "$output/original-source/$file" | sha256sum -c -
}
verify RayCreator.java 4e8a5ce9311ad03c15992b6bcf9da4e030fc7ded74ab853824a6bc4426cf7b70
verify OrthographicCameraRayCreator.java fa18651447f82b9faf3846de23556e18f8f98a5ee1be1c7dfb535403f57c1e2d
verify Camera.java 64580b792765ee22c15e64b5882671878ac0678a2d1179eab0b44afa574eda4c
verify Ray.java ccd6173604a4e47df214fcca4e8a8c33be6997a65feae69cf230d05328ad28aa
verify Helper.java bc78f6d3456155ce405f54bd64a9bf2806e777d855a27cc937dbe1e1f327a463
verify RendererEngine.java b7b4053bb5af9e727e33b5d9df49fbdafaad97da3b0d2be9a089a0a19ed65283
javac --version > "$output/javac-version.txt" 2>&1
rg '^javac 17[.]' "$output/javac-version.txt"
java -XX:-UsePerfData -version > "$output/java-version.txt" 2>&1
cd "$output/original-source"
rg -l '^package de[.]mfo[.]jsurf[.]' --glob '*.java' --maxdepth 1 . | LC_ALL=C sort > "$output/original-sources.txt"
xargs sha256sum < "$output/original-sources.txt" > "$output/original-sources.sha256"
var harness = "$repository/examples/autogenerated/original-camera/OriginalCameraOracle.java"
sha256sum "$harness" "$antlr" "$vecmath" > "$output/adapter-and-dependencies.sha256"
javac --release 17 -cp "$antlr:$vecmath" -d "$output/classes" \
  "@$output/original-sources.txt" "$harness" > "$output/compiler.txt" 2>&1
for name in observations repeat {
  java -XX:-UsePerfData -cp "$output/classes:$antlr:$vecmath" \
    de.mfo.jsurf.rendering.cpu.OriginalCameraOracle > "$output/$name.tsv" 2> "$output/$name.stderr"
  test ! -s "$output/$name.stderr"
}
cmp "$output/observations.tsv" "$output/repeat.tsv"
test $(rg -c b'^camera_case\t' "$output/observations.tsv") = 7
test $(rg -c b'^camera_end\t' "$output/observations.tsv") = 7
test $(rg -c b'^matrix\t' "$output/observations.tsv") = 672
test $(rg -c b'^vector\t' "$output/observations.tsv") = 84
test $(rg -c b'^sample\t' "$output/observations.tsv") = 109
test $(rg -c b'^ray\t' "$output/observations.tsv") = 327
test $(rg -c b'^ray_point\t' "$output/observations.tsv") = 1962
test $(rg -c b'^normal\t' "$output/observations.tsv") = 28
sha256sum "$output/observations.tsv" > "$output/observations.sha256"
printf 'frozen_original_source\tPASS\noriginal_Java17_compile\tPASS\nactual_camera_constructor\tPASS\nactual_field_observations\tPASS\nactual_transformU_transformV_ray_bundle\tPASS\nactual_ray_at_normal_transform\tPASS\nrepeat_bytes\tPASS\nprofiles\t7\nsamples\t109\nrays\t327\nray_points\t1962\ncandidate_C\tNOT_RUN\nfull_image_parity\tNOT_ESTABLISHED\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m actual original camera reference; candidate C qualification separate\n'
