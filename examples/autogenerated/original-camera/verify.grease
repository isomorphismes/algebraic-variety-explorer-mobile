#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease verify.grease EXPLORER ICK_SOURCE QUALIFIED_ICK ORIGINAL_CAMERA_REFERENCE FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var ick_source = ARGV[1]
var compiler = ARGV[2]
var reference = ARGV[3]
var output = ARGV[4]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused camera evidence' >&2; exit 1 }
test $(git -C "$ick_source" rev-parse HEAD) = fbe86e23d55cfec2000c08e61deea2a407fd7175
test -x "$compiler"
command -v rg > /dev/null
rg -x -F b'actual_camera_constructor\tPASS' "$reference/result.tsv"
rg -x -F b'actual_transformU_transformV_ray_bundle\tPASS' "$reference/result.tsv"
rg -x -F b'actual_ray_at_normal_transform\tPASS' "$reference/result.tsv"
rg -x -F b'repeat_bytes\tPASS' "$reference/result.tsv"
var manifest = "$repository/ci/native-camera-toolchain.tsv"
rg -x -F b'build_id\ttarget\ttoolchain\tick_revision\tick_status\tick_evidence' "$manifest"
for stage in numerical normalization-mutant offset-mutant interpolation-mutant inverse-mutant sanitizers {
  printf 'native-camera-%s\tx86_64-pc-linux-gnu\tick\tfbe86e23d55cfec2000c08e61deea2a407fd7175\tqualified\treceipt:ai-ci-ick-host-32cb45b3\n' "$stage" | rg -x -F -f - "$manifest"
}
test $(wc -l < "$manifest") = 7
mkdir -p "$output/mutants"
"$compiler" --version > "$output/ick-version.txt"
"$compiler" -dumpmachine > "$output/ick-target.txt"
rg -x -F x86_64-pc-linux-gnu "$output/ick-target.txt"
var cc1 = $("$compiler" -print-prog-name=cc1)
test -x "$cc1"
sha256sum "$compiler" "$cc1" > "$output/toolchain.sha256"
sha256sum "$repository/native/surfer_raytracer.c" "$repository/native/surfer_raytracer.h" \
  "$repository/native/surfer_original_specialization.inc" "$repository/native/surfer_original_camera.inc" \
  "$repository/native/surfer_vecmath.c" "$repository/native/surfer_vecmath.h" "$repository/native/surfer_camera_test.c" \
  "$reference/observations.tsv" > "$output/inputs.sha256"
cp "$reference/result.tsv" "$output/original-reference-profile.tsv"
cp "$manifest" "$output/toolchain.tsv"
git -C "$repository" rev-parse HEAD > "$output/source-revision.txt"
proc compile_camera(directory, destination) {
  "$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
    -fno-fast-math -ffp-contract=off "$directory/surfer_camera_test.c" "$directory/surfer_vecmath.c" -lm -o "$destination"
}
compile_camera "$repository/native" "$output/test"
"$output/test" "$reference/observations.tsv" > "$output/numerical.txt" 2>&1
cat "$output/numerical.txt"
rg -x -F 'PASS original orthographic matrices normalization offsets rays and normals' "$output/numerical.txt"
proc reject_mutant(name, source, expression) {
  var destination = "$output/mutants/$name"
  mkdir -p "$destination"
  for file in surfer_raytracer.c surfer_raytracer.h surfer_original_specialization.inc \
    surfer_original_camera.inc surfer_vecmath.c surfer_vecmath.h surfer_camera_test.c {
    cp "$repository/native/$file" "$destination/"
  }
  sed "$expression" "$repository/native/$source" > "$destination/changed"
  try { cmp -s "$repository/native/$source" "$destination/changed" }
  if (_error.code !== 1) { echo 'FAIL camera mutation unchanged or comparison failed' >&2; exit 1 }
  mv "$destination/changed" "$destination/$source"
  compile_camera "$destination" "$destination/test"
  try { "$destination/test" "$reference/observations.tsv" > "$destination/result.txt" 2>&1 }
  var status = _error.code
  cat "$destination/result.txt"
  if (status !== 1) { echo "FAIL missing designated camera mutation rejection: $name" >&2; exit 1 }
  rg '^FAIL original camera:' "$destination/result.txt"
}
reject_mutant normalization surfer_original_camera.inc 's/camera->surface_direction, 1.0 \/ direction_scale/camera->surface_direction, 1.0/'
reject_mutant offset surfer_original_camera.inc 's/camera->uoffset = dot_product(projected, camera->surface_du);/camera->uoffset = 0.0 * dot_product(projected, camera->surface_du);/'
reject_mutant interpolation surfer_original_camera.inc 's/origin.x + horizontal.x \* u + vertical.x \* v/origin.x + (horizontal.x * u + vertical.x * v)/'
reject_mutant inverse surfer_vecmath.c 's/values\[6\] \* inverse->entries/0.0 * values[6] * inverse->entries/'
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O1 -g \
  -fno-fast-math -ffp-contract=off -fsanitize=address,undefined -fno-omit-frame-pointer \
  "$repository/native/surfer_camera_test.c" "$repository/native/surfer_vecmath.c" -lm -o "$output/sanitized"
env ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1 \
  "$output/sanitized" "$reference/observations.tsv" > "$output/sanitizers.txt" 2>&1
cat "$output/sanitizers.txt"
rg -x -F 'PASS original orthographic matrices normalization offsets rays and normals' "$output/sanitizers.txt"
sha256sum "$output/test" "$output/sanitized" > "$output/binaries.sha256"
printf 'same_original_camera_profile_bits\tPASS\nreference_profile\tsee-original-reference-profile.tsv\nfour_compiled_mutants\tPASS\nASAN_UBSAN_leaks\tPASS\nfull_shading_roots_image_tiling\tNOT_ESTABLISHED\nAndroid\tNOT_RUN\nphysical_devices\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m original restricted orthographic camera; full image acceptance separate\n'
