#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 4) {
  echo 'usage: grease verify.grease EXPLORER ICK_SOURCE QUALIFIED_ICK FRESH_OUTPUT' >&2
  exit 2
}
var repository = ARGV[0]
var ick_source = ARGV[1]
var compiler = ARGV[2]
var output = ARGV[3]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused session evidence' >&2; exit 1 }
test -x "$compiler"
test $(git -C "$ick_source" rev-parse HEAD) = fbe86e23d55cfec2000c08e61deea2a407fd7175
command -v rg > /dev/null
command -v nm > /dev/null
var manifest = "$repository/ci/native-session-toolchain.tsv"
rg -x -F b'build_id\ttarget\ttoolchain\tick_revision\tick_status\tick_evidence' "$manifest"
for stage in core registry sanitizers core-poll-mutant bisection-mutant session-poll-mutant publish-mutant {
  printf 'native-session-%s\tx86_64-pc-linux-gnu\tick\tfbe86e23d55cfec2000c08e61deea2a407fd7175\tqualified\treceipt:ai-ci-ick-host-32cb45b3\n' "$stage" \
    | rg -x -F -f - "$manifest"
}
test $(wc -l < "$manifest") = 8
mkdir -p "$output/mutants"
"$compiler" --version > "$output/compiler-version.txt"
"$compiler" -dumpmachine > "$output/compiler-target.txt"
rg -x -F x86_64-pc-linux-gnu "$output/compiler-target.txt"
var cc1 = $("$compiler" -print-prog-name=cc1)
test -x "$cc1"
sha256sum "$compiler" "$cc1" > "$output/compiler-artifacts.sha256"
cp "$manifest" "$output/build-toolchain.tsv"
git -C "$repository" rev-parse HEAD > "$output/source-revision.txt"
sha256sum "$repository/native/surfer_raytracer.c" "$repository/native/surfer_raytracer.h" \
  "$repository/native/surfer_original_specialization.inc" "$repository/native/surfer_original_camera.inc" "$repository/native/surfer_vecmath.h" "$repository/native/surfer_vecmath.c" \
  "$repository/native/surfer_cancel_test.c" "$repository/native/surfer_render_session.c" \
  "$repository/native/surfer_render_session.h" "$repository/native/surfer_render_session_test.c" \
  "$repository/native/surfer_original_workers.inc" \
  "$repository/native/surfer_surface_store.c" "$repository/native/surfer_surface_store.h" \
  > "$output/inputs.sha256"

printf '\033[36mACTION\033[0m exercise cancellation inside real numerical loops\n'
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
  -fno-fast-math -ffp-contract=off "$repository/native/surfer_cancel_test.c" "$repository/native/surfer_vecmath.c" -lm -o "$output/core-test"
"$output/core-test" > "$output/core.txt" 2>&1
cat "$output/core.txt"
rg -x -F 'SURFER cooperative numerical cancellation: PASS' "$output/core.txt"

proc build_registry(source, destination) {
  mkdir -p "$destination"
  "$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
    -fno-fast-math -ffp-contract=off -DSURFER_RENDER_SESSION_TESTING -DSURFER_SURFACE_STORE_TESTING \
    "$source" "$repository/native/surfer_render_session_test.c" \
    "$repository/native/surfer_surface_store.c" "$repository/native/surfer_raytracer.c" \
    -I "$repository/native" "$repository/native/surfer_vecmath.c" -lm -pthread -o "$destination/test"
}
build_registry "$repository/native/surfer_render_session.c" "$output/registry"
"$output/registry/test" > "$output/registry.txt" 2>&1
cat "$output/registry.txt"
rg -x -F 'SURFER cooperative render sessions, publication and ownership: PASS' "$output/registry.txt"
nm -u "$output/registry/test" > "$output/host-undefined-symbols.txt"
try { rg -n '__atomic_|__sync_' "$output/host-undefined-symbols.txt" }
var atomic_imports = _error.code
if (atomic_imports !== 1) { echo 'FAIL unexpected host atomic import or scanner failure' >&2; exit 1 }

printf '\033[36mACTION\033[0m require sanitizer and leak execution on the hosted owner\n'
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O1 -g \
  -fno-fast-math -ffp-contract=off -fsanitize=address,undefined -fno-omit-frame-pointer \
  "$repository/native/surfer_cancel_test.c" "$repository/native/surfer_vecmath.c" -lm -o "$output/core-sanitized"
env ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1 \
  "$output/core-sanitized" > "$output/core-sanitized.txt" 2>&1
cat "$output/core-sanitized.txt"
rg -x -F 'SURFER cooperative numerical cancellation: PASS' "$output/core-sanitized.txt"
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O1 -g \
  -fno-fast-math -ffp-contract=off -fsanitize=address,undefined -fno-omit-frame-pointer \
  -DSURFER_RENDER_SESSION_TESTING -DSURFER_SURFACE_STORE_TESTING \
  "$repository/native/surfer_render_session.c" "$repository/native/surfer_render_session_test.c" \
  "$repository/native/surfer_surface_store.c" "$repository/native/surfer_raytracer.c" \
  "$repository/native/surfer_vecmath.c" -lm -pthread -o "$output/registry-sanitized"
env ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1 \
  "$output/registry-sanitized" > "$output/registry-sanitized.txt" 2>&1
cat "$output/registry-sanitized.txt"
rg -x -F 'SURFER cooperative render sessions, publication and ownership: PASS' "$output/registry-sanitized.txt"

proc reject_core_mutant(name, expression) {
  var destination = "$output/mutants/$name"
  mkdir -p "$destination"
  cp "$repository/native/surfer_raytracer.h" "$repository/native/surfer_original_specialization.inc" "$repository/native/surfer_original_camera.inc" "$repository/native/surfer_vecmath.h" "$repository/native/surfer_vecmath.c" \
    "$repository/native/surfer_cancel_test.c" "$destination/"
  sed "$expression" "$repository/native/surfer_raytracer.c" > "$destination/surfer_raytracer.c"
  try { cmp -s "$repository/native/surfer_raytracer.c" "$destination/surfer_raytracer.c" }
  if (_error.code !== 1) { echo 'FAIL unchanged mutant or comparison failure' >&2; exit 1 }
  "$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
    -fno-fast-math -ffp-contract=off "$destination/surfer_cancel_test.c" "$repository/native/surfer_vecmath.c" -lm -o "$destination/test"
  try { "$destination/test" > "$destination/result.txt" 2>&1 }
  var status = _error.code
  cat "$destination/result.txt"
  if (status !== 1) { echo "FAIL expected core mutant rejection absent: $name" >&2; exit 1 }
  rg -x -F 'FAIL cooperative numerical cancellation: bisection cancellation' "$destination/result.txt"
}
reject_core_mutant core-poll 's/context->cancellation != NULL/false/'
reject_core_mutant bisection '/^static double bisect_root_interval/,/^}/s/if (!continue_operation(context)) return NAN;/if (false) return NAN;/'

proc reject_registry_mutant(name, expression, diagnostic) {
  var destination = "$output/mutants/$name"
  mkdir -p "$destination"
  cp "$repository/native/surfer_render_session.h" "$repository/native/surfer_original_workers.inc" "$destination/"
  sed "$expression" "$repository/native/surfer_render_session.c" > "$destination/surfer_render_session.c"
  try { cmp -s "$repository/native/surfer_render_session.c" "$destination/surfer_render_session.c" }
  if (_error.code !== 1) { echo 'FAIL unchanged registry mutant or comparison failure' >&2; exit 1 }
  build_registry "$destination/surfer_render_session.c" "$destination"
  try { "$destination/test" > "$destination/result.txt" 2>&1 }
  var status = _error.code
  cat "$destination/result.txt"
  if (status !== 1) { echo "FAIL expected registry mutant rejection absent: $name" >&2; exit 1 }
  rg -x -F "$diagnostic" "$destination/result.txt"
}
reject_registry_mutant session-poll 's/const bool cancelled = state->epoch->cancelled;/const bool cancelled = false;/' \
  'FAIL render session: epoch flag did not stop first numerical cancellation poll'
reject_registry_mutant publish 's/const bool publish_current = is_current_locked(session, epoch);/const bool publish_current = true;/' \
  'FAIL render session: final currentness gate accepted stale frame'

printf 'numerical_checkpoints\tPASS\nretained_epochs_and_surface_lifetimes\tPASS\ntransactional_current_publication\tPASS\nsanitizers_and_leaks\tPASS\ncore_and_registry_compiled_mutants\tPASS\nARM32_atomic_imports\tNOT_RUN\nJNI_ART\tNOT_RUN\nthread_pool_tile_parity\tNOT_ESTABLISHED\nphysical_devices\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m cooperative native session slice; target and UI acceptance separate\n'
