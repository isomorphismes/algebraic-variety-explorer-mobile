#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 5) { echo 'usage: grease verify.grease EXPLORER ICK_SOURCE QUALIFIED_ICK ORIGINAL_TILE_REFERENCE FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var ick_source = ARGV[1]
var compiler = ARGV[2]
var reference = ARGV[3]
var output = ARGV[4]
for path in (ARGV) { if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 } }
if test -e "$output" { echo 'FAIL refusing reused original-tile evidence' >&2; exit 1 }
test $(git -C "$ick_source" rev-parse HEAD) = fbe86e23d55cfec2000c08e61deea2a407fd7175
test -x "$compiler"
command -v rg > /dev/null
rg -x -F b'actual_ordered_private_RenderingTask_tiles\tPASS' "$reference/result.tsv"
rg -x -F b'actual_serial_draw_matches_ordered_tiles\tPASS' "$reference/result.tsv"
var manifest = "$repository/ci/native-tiles-toolchain.tsv"
rg -x -F b'build_id\ttarget\ttoolchain\tick_revision\tick_status\tick_evidence' "$manifest"
for stage in numerical center-mutant aa-mutant inclusive-mutant legacy sanitizers {
  printf 'native-tiles-%s\tx86_64-pc-linux-gnu\tick\tfbe86e23d55cfec2000c08e61deea2a407fd7175\tqualified\treceipt:ai-ci-ick-host-32cb45b3\n' "$stage" | rg -x -F -f - "$manifest"
}
test $(wc -l < "$manifest") = 7
mkdir -p "$output/mutants"
"$compiler" --version > "$output/ick-version.txt"
"$compiler" -dumpmachine > "$output/ick-target.txt"
rg -x -F x86_64-pc-linux-gnu "$output/ick-target.txt"
var cc1 = $("$compiler" -print-prog-name=cc1)
test -x "$cc1"
sha256sum "$compiler" "$cc1" > "$output/toolchain.sha256"
sha256sum "$repository/native/surfer_raytracer.c" "$repository/native/surfer_raytracer.h" \
  "$repository/native/surfer_original_specialization.inc" "$repository/native/surfer_original_camera.inc" \
  "$repository/native/surfer_vecmath.c" "$repository/native/surfer_vecmath.h" "$repository/native/surfer_original_tile_test.c" \
  "$reference/ordered-workers.tsv" > "$output/inputs.sha256"
cp "$reference/result.tsv" "$output/original-reference-profile.tsv"
cp "$manifest" "$output/toolchain.tsv"
git -C "$repository" rev-parse HEAD > "$output/source-revision.txt"
proc compile_tiles(directory, destination) {
  "$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
    -fno-fast-math -ffp-contract=off "$directory/surfer_original_tile_test.c" "$directory/surfer_vecmath.c" -lm -o "$destination"
}
compile_tiles "$repository/native" "$output/test"
"$output/test" "$reference/ordered-workers.tsv" > "$output/numerical.txt" 2>&1
rg '^(original tiles|tile allocation|PASS)' "$output/numerical.txt"
rg -x -F 'PASS original private tile bytes inclusive overlaps and submission-order composition' "$output/numerical.txt"
proc reject_mutant(name, expression) {
  var destination = "$output/mutants/$name"
  mkdir -p "$destination"
  for file in surfer_raytracer.h surfer_original_specialization.inc surfer_original_camera.inc \
      surfer_vecmath.c surfer_vecmath.h surfer_original_tile_test.c {
    cp "$repository/native/$file" "$destination/"
  }
  sed "$expression" "$repository/native/surfer_raytracer.c" > "$destination/surfer_raytracer.c"
  try { cmp -s "$repository/native/surfer_raytracer.c" "$destination/surfer_raytracer.c" }
  if (_error.code !== 1) { echo 'FAIL tile mutation unchanged' >&2; exit 1 }
  compile_tiles "$destination" "$destination/test"
  try { "$destination/test" "$reference/ordered-workers.tsv" > "$destination/result.txt" 2>&1 }
  if (_error.code !== 1) { echo "FAIL missing designated tile mutation rejection: $name" >&2; exit 1 }
  rg '^(pixel|FAIL)' "$destination/result.txt"
  rg '^FAIL original tile:' "$destination/result.txt"
}
reject_mutant center 's/(double)x_start \/ (double)(width - 1)/0.0 \/ (double)(width - 1)/'
reject_mutant aa 's/((double)x_start - 0.5) \/ (double)(width - 1)/((double)x_start + 0.5) \/ (double)(width - 1)/'
reject_mutant inclusive 's/const size_t tile_width = x_end - x_start + 1;/const size_t tile_width = x_end - x_start;/'
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
  -fno-fast-math -ffp-contract=off -DSURFER_STATUS_API -I "$repository/native" -I "$repository/native/android" \
  "$repository/native/surfer_raytracer.c" "$repository/native/android/presets.c" \
  "$repository/native/surfer_success_oracle.c" "$repository/native/surfer_vecmath.c" -lm -o "$output/legacy-success"
"$output/legacy-success" > "$output/legacy-success.bin"
test $(wc -c < "$output/legacy-success.bin") = 32179
printf '%s  %s\n' 65f44c201676e330068804e4059a369cb6479efa1673660fd78a42681a1f55ca "$output/legacy-success.bin" | sha256sum -c -
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O1 -g \
  -fno-fast-math -ffp-contract=off -fsanitize=address,undefined -fno-omit-frame-pointer \
  "$repository/native/surfer_original_tile_test.c" "$repository/native/surfer_vecmath.c" -lm -o "$output/sanitized"
env ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1 \
  "$output/sanitized" "$reference/ordered-workers.tsv" > "$output/sanitizers.txt" 2>&1
rg '^(original tiles|tile allocation|PASS)' "$output/sanitizers.txt"
rg -x -F 'PASS original private tile bytes inclusive overlaps and submission-order composition' "$output/sanitizers.txt"
sha256sum "$output/test" "$output/sanitized" "$output/legacy-success" > "$output/binaries.sha256"
sha256sum "$reference/ordered-workers.tsv" "$output/numerical.txt" "$output/sanitizers.txt" > "$output/decoded-argb.sha256"
printf 'comparison\texact-private-tile-and-ordered-ARGB\nchannel_tolerance\t0\nobserved_differences\t0\n' > "$output/pixel-differences.tsv"
printf 'original_private_tile_pixels\tPASS\noriginal_submission_order_composition\tPASS\nfull_canvas_control\tPASS\nactual_tile_allocation_faults\tPASS\nactual_tile_cancellation\tPASS\nthree_compiled_mutants\tPASS\nlegacy_success_bytes\tPASS\nASAN_UBSAN_leaks\tPASS\nmax_four_worker_owner\tNOT_ESTABLISHED\nAndroid\tNOT_RUN\nphysical_devices\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m original numerical tiles and ordered composition; worker owner separate\n'
