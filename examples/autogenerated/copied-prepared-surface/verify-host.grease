#!/usr/bin/env grease
if (len(ARGV) !== 3) { echo 'usage: grease verify-host.grease EXPLORER QUALIFIED_ICK FRESH_OUTPUT' >&2; exit 2 }
var repository = ARGV[0]
var compiler = ARGV[1]
var output = ARGV[2]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
test -x "$compiler"
command -v rg
if test -e "$output" { echo 'FAIL refusing reused receiver evidence output' >&2; exit 1 }
mkdir -p "$output"
"$compiler" --version > "$output/ick-version.txt"
"$compiler" -dumpmachine > "$output/ick-target.txt"
rg -x -F 'x86_64-pc-linux-gnu' "$output/ick-target.txt"
sha256sum "$compiler" > "$output/ick-compiler.sha256"
sha256sum "$repository/native/surfer_surface_store.c" \
  "$repository/native/surfer_surface_store.h" \
  "$repository/native/surfer_surface_store_test.c" \
  "$repository/native/surfer_raytracer.c" "$repository/native/surfer_raytracer.h" \
  > "$output/sources.sha256"
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
  -fno-fast-math -ffp-contract=off -DSURFER_SURFACE_STORE_TESTING \
  "$repository/native/surfer_surface_store.c" \
  "$repository/native/surfer_surface_store_test.c" \
  "$repository/native/surfer_raytracer.c" -lm -pthread \
  -o "$output/surface-store-test" > "$output/compile.txt" 2>&1
cat "$output/compile.txt"
"$output/surface-store-test" > "$output/test.txt" 2>&1
cat "$output/test.txt"
rg -x -F 'PASS copied PreparedSurface ownership and render borrowing' "$output/test.txt"
"$compiler" -fno-link-libatomic -std=c17 -Wall -Wextra -Werror -pedantic -O1 -g \
  -fno-fast-math -ffp-contract=off -DSURFER_SURFACE_STORE_TESTING \
  -fsanitize=address,undefined -fno-omit-frame-pointer \
  "$repository/native/surfer_surface_store.c" "$repository/native/surfer_surface_store_test.c" \
  "$repository/native/surfer_raytracer.c" -lm -pthread \
  -o "$output/surface-store-sanitized-test" > "$output/sanitized-compile.txt" 2>&1
cat "$output/sanitized-compile.txt"
env ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1 \
  "$output/surface-store-sanitized-test" > "$output/sanitized-test.txt" 2>&1
cat "$output/sanitized-test.txt"
rg -x -F 'PASS copied PreparedSurface ownership and render borrowing' "$output/sanitized-test.txt"
sha256sum "$output/surface-store-test" > "$output/test-binary.sha256"
printf 'copied_receiver_host\tPASS\nreceiver_sanitizers_and_leaks\tPASS\nJNI_ART\tNOT_RUN\nAPK\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m copied PreparedSurface validation, ownership and render borrowing on qualified ICK host\n'
