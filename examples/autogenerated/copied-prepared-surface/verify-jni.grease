#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) !== 6) { echo 'usage: grease verify-jni.grease EXPLORER QUALIFIED_X86_64_ICK NDK FRESH_OUTPUT SMALI BAKSMALI' >&2; exit 2 }
var repository = ARGV[0]
var compiler = ARGV[1]
var ndk = ARGV[2]
var output = ARGV[3]
var smali = ARGV[4]
var baksmali = ARGV[5]
for path in (ARGV) {
  if (path[0] !== '/') { echo 'FAIL absolute paths required' >&2; exit 2 }
}
test -x "$compiler"
if test -e "$output" { echo 'FAIL refusing reused JNI evidence output' >&2; exit 1 }
rg '^Pkg.Revision[[:space:]]*=[[:space:]]*29\.0\.14206865$' "$ndk/source.properties"
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
var sysroot = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/sysroot"
var linker = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android26-clang"
var qualification_linker = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android29-clang"
var nm = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-nm"
test -x "$linker"
test -x "$qualification_linker"
test -s "$sysroot/usr/include/jni.h"
mkdir -p "$output/production" "$output/qualification"
"$compiler" --version > "$output/ick-version.txt"
"$compiler" -dumpmachine > "$output/ick-target.txt"
rg '^x86_64-' "$output/ick-target.txt"
sha256sum "$compiler" > "$output/ick-compiler.sha256"
sha256sum "$repository/native/android/activity_jni_owner.h" > "$output/jni-owner.sha256"
sha256sum "$repository/native/surfer_original_specialization.inc" "$repository/native/surfer_original_camera.inc" \
  "$repository/native/surfer_vecmath.c" "$repository/native/surfer_vecmath.h" > "$output/nested-specialization.sha256"
proc compile_source(source, name) {
  "$compiler" --sysroot="$sysroot" -isystem "$sysroot/usr/include" \
    -isystem "$sysroot/usr/include/x86_64-linux-android" \
    -D__ANDROID__ -D__ANDROID_API__=26 -DBIONIC_IOCTL_NO_SIGNEDNESS_OVERLOAD \
    -std=c17 -Wall -Wextra -Werror -pedantic -O2 -fPIC -fvisibility=hidden -fno-stack-protector \
    -march=x86-64-v2 -mno-avx -mno-movbe -fno-fast-math -ffp-contract=off \
    -c "$repository/$source" -o "$output/production/$name.o"
  "$compiler" --sysroot="$sysroot" -isystem "$sysroot/usr/include" \
    -isystem "$sysroot/usr/include/x86_64-linux-android" \
    -D__ANDROID__ -D__ANDROID_API__=29 -DBIONIC_IOCTL_NO_SIGNEDNESS_OVERLOAD \
    -DSURFER_SURFACE_STORE_TESTING -DSURFER_SURFACE_JNI_TESTING \
    -DSURFER_FRAME_OUTPUT_TESTING -DSURFER_RENDER_JNI_TESTING \
    -std=c17 -Wall -Wextra -Werror -pedantic -O2 -fPIC -fno-stack-protector \
    -march=x86-64-v2 -mno-avx -mno-movbe -fno-fast-math -ffp-contract=off \
    -c "$repository/$source" -o "$output/qualification/$name.o"
}
compile_source native/surfer_raytracer.c numerical
compile_source native/surfer_vecmath.c vecmath
compile_source native/surfer_surface_store.c ownership
compile_source native/android/prepared_surface_jni.c jni
compile_source native/surfer_frame_output.c frame
compile_source native/android/render_surface_jni.c render-jni
"$compiler" --sysroot="$sysroot" -isystem "$sysroot/usr/include" \
  -isystem "$sysroot/usr/include/x86_64-linux-android" \
  -D__ANDROID__ -D__ANDROID_API__=29 -DBIONIC_IOCTL_NO_SIGNEDNESS_OVERLOAD \
  -DSURFER_SURFACE_STORE_TESTING -DSURFER_SURFACE_JNI_TESTING \
  -std=c17 -Wall -Wextra -Werror -pedantic -O2 -fPIC -fno-stack-protector \
  -march=x86-64-v2 -mno-avx -mno-movbe -fno-fast-math -ffp-contract=off \
  -c "$repository/examples/autogenerated/copied-prepared-surface/receiver_observer.c" \
  -o "$output/qualification/observer.o"
"$compiler" --sysroot="$sysroot" -isystem "$sysroot/usr/include" \
  -isystem "$sysroot/usr/include/x86_64-linux-android" \
  -D__ANDROID__ -D__ANDROID_API__=29 -DBIONIC_IOCTL_NO_SIGNEDNESS_OVERLOAD \
  -DSURFER_SURFACE_STORE_TESTING -DSURFER_FRAME_OUTPUT_TESTING -DSURFER_RENDER_JNI_TESTING \
  -std=c17 -Wall -Wextra -Werror -pedantic -O2 -fPIC -fno-stack-protector \
  -march=x86-64-v2 -mno-avx -mno-movbe -fno-fast-math -ffp-contract=off \
  -c "$repository/examples/autogenerated/render-pixels/render_pixel_observer.c" \
  -o "$output/qualification/render-observer.o"
# The platform driver receives objects only; ICK compiled every C source.
"$linker" -shared -Wl,-z,defs -Wl,-z,relro -Wl,-z,now -Wl,-z,max-page-size=16384 \
  "$output/production/numerical.o" "$output/production/ownership.o" "$output/production/jni.o" \
  "$output/production/frame.o" "$output/production/render-jni.o" \
  "$output/production/vecmath.o" \
  -lm -o "$output/production/libave_prepared_surface.so"
"$qualification_linker" -shared -Wl,-z,defs -Wl,-z,relro -Wl,-z,now -Wl,-z,max-page-size=16384 \
  "$output/qualification/numerical.o" "$output/qualification/ownership.o" \
  "$output/qualification/jni.o" "$output/qualification/observer.o" \
  "$output/qualification/frame.o" "$output/qualification/render-jni.o" "$output/qualification/render-observer.o" \
  "$output/qualification/vecmath.o" \
  -lm -o "$output/qualification/libave_prepared_surface_test.so"
"$nm" -D --defined-only "$output/production/libave_prepared_surface.so" > "$output/production/exports.txt"
"$nm" -D --undefined-only "$output/production/libave_prepared_surface.so" > "$output/production/imports.txt"
"$nm" -D --undefined-only "$output/qualification/libave_prepared_surface_test.so" > "$output/qualification/imports.txt"
try { rg '__stack_chk' "$output/production/imports.txt" "$output/qualification/imports.txt" }
var stack_guard_symbols = _error.code
if (stack_guard_symbols !== 1) { echo 'FAIL unexpected stack-protector import or symbol checker failed' >&2; exit 1 }
for method in copyPreparedSurface replacePreparedSurface releasePreparedSurface renderPreparedSurface {
  rg -e " Java_Idric_Generated_$method\$" "$output/production/exports.txt"
}
try { rg 'surfer_(surface|frame|render)_.*test|Java_(CopiedSurface|RenderPixel)Observer' "$output/production/exports.txt" }
var production_test_symbols = _error.code
if (production_test_symbols !== 1) { echo 'FAIL production library includes test symbols or symbol checker failed' >&2; exit 1 }
java -jar "$smali" assemble \
  "$repository/examples/autogenerated/copied-prepared-surface/CopiedSurfaceObserver.smali" \
  "$repository/examples/autogenerated/copied-prepared-surface/CopiedSurfaceRunner.smali" \
  -o "$output/receiver-runner.dex"
java -jar "$baksmali" disassemble "$output/receiver-runner.dex" -o "$output/decoded"
sha256sum "$output/production/libave_prepared_surface.so" \
  "$output/qualification/libave_prepared_surface_test.so" "$output/receiver-runner.dex" > "$output/artifacts.sha256"
printf 'receiver_JNI_ICK_build\tPASS\nJNI_ART\tNOT_RUN\nAPK\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/build-result.tsv"
printf '\033[32mPASS\033[0m ICK-compiled receiver JNI libraries and independent observer; ART separate\n'
