#!/usr/bin/env grease
set -eu -o pipefail

# Provisioning and signing are separate operations. This entry compiles the
# current application source; it never fetches an APK or generates a signer.
if (len(ARGV) === 0 or ARGV[0] === '--help') {
  echo 'usage: grease build.grease release REPOSITORY FRONTEND_SOURCE DEX_BACKEND_SOURCE ARM64_ICK_SOURCE ARMV7_ICK_SOURCE X64_ICK_SOURCE SDK NDK BAKSMALI SMALI FRESH_OUTPUT'
  echo 'All paths must be absolute. Compilers must already be built from the exact revisions in build-inputs.tsv.'
  echo 'The output is an unsigned APK and separate source/build/packaging receipts. No phone build is supported.'
  exit 0
}
if (len(ARGV) !== 12 or ARGV[0] !== 'release') {
  echo 'FAIL expected release followed by eleven absolute input/output paths; use --help' >&2
  exit 2
}
var repository = ARGV[1]
var frontend = ARGV[2]
var backend = ARGV[3]
var ick_arm64 = ARGV[4]
var ick_armv7 = ARGV[5]
var ick_x64 = ARGV[6]
var sdk = ARGV[7]
var ndk = ARGV[8]
var baksmali = ARGV[9]
var smali = ARGV[10]
var output = ARGV[11]
for path in (ARGV[1:]) {
  if (len(path) === 0 or path[0] !== '/') { echo 'FAIL absolute build paths required' >&2; exit 2 }
  # Make invokes the compiler command through its shell. Reject characters
  # which could become shell syntax instead of pretending Make quotes them.
  printf '%s\n' "$path" | rg -x '/[A-Za-z0-9_./+-]+'
}
if test -e "$output" { echo 'FAIL refusing reused build output' >&2; exit 1 }
test $(uname -s) = Linux
test $(uname -m) = x86_64
var grease = $(command -v grease)
test -x "$grease"
var inputs = "$repository/build-inputs.tsv"
proc pinned_revision(name) {
  test $(awk -F '\t' -v name="$name" '$1 == name { count++ } END { print count+0 }' "$inputs") = 1
  awk -F '\t' -v name="$name" '$1 == name { print $3 }' "$inputs"
}
proc source_at(path, name) {
  test $(git -C "$path" rev-parse HEAD) = $(pinned_revision "$name")
  test -z $(git -C "$path" status --porcelain --untracked-files=no)
}
source_at "$frontend" frontend
source_at "$backend" dex-backend
source_at "$ick_arm64" ick-cross
source_at "$ick_armv7" ick-cross
source_at "$ick_x64" ick-cross
test -s "$frontend/_/build/exec/idris2_app/idris2.so"
test -x "$frontend/_/build/exec/idris2"
test -x "$frontend/_/.tools/chez-10.4.1/bin/scheme"
proc compiler_at(source, target) {
  test -x "$source/stage/bin/$target-gcc"
  test $("$source/stage/bin/$target-gcc" -dumpmachine) = "$target"
}
compiler_at "$ick_arm64" aarch64-linux-gnu
compiler_at "$ick_armv7" arm-linux-gnueabi
compiler_at "$ick_x64" x86_64-linux-gnu
rg '^Pkg.Revision[[:space:]]*=[[:space:]]*29\.0\.14206865$' "$ndk/source.properties"
rg '^Pkg.Revision[[:space:]]*=[[:space:]]*35\.0\.1$' "$sdk/build-tools/35.0.1/source.properties"
test -s "$sdk/platforms/android-35/android.jar"
printf '%s  %s\n' 37ae4a41a8886e15c20b8362fa4250f96bbdb55e1a608199ad8b5dff068b588f "$baksmali" | sha256sum -c -
printf '%s  %s\n' 32fa0e88a6c397b3922201adf5f3e534fbaed5a663c71d0c558c3ddce0af844a "$smali" | sha256sum -c -
for program in make java zip unzip sha256sum cmp sed rg od touch readlink awk { command -v "$program" }
mkdir -p "$output/native"
cp "$inputs" "$output/build-inputs.tsv"
git -C "$repository" rev-parse HEAD > "$output/application-head.txt"
git -C "$repository" status --porcelain > "$output/application-status.txt"

printf '\033[36mACTION\033[0m build the checked direct DEX backend from pinned source\n'
"$grease" "$backend/dex/idric/install-frontend.grease" "$frontend"
setglobal ENV.CHEZ = "$frontend/_/.tools/bin/scheme"
setglobal ENV.PATH = "$frontend/_/.tools/bin:" ++ ENV.PATH
setglobal ENV.IDRIS2_PREFIX = "$frontend/_/bootstrap-build"
setglobal ENV.IDRIS2_PACKAGE_PATH = "$frontend/_/bootstrap-build/idris2-0.8.0"
# A forced Make recipe alone would still let Idriç reuse preexisting TTC files.
# Build in a fresh local source clone instead, leaving the supplied checkout's
# output untouched. No remote source or compiled payload is fetched here.
var backend_build = "$output/backend-source"
git clone --shared --no-checkout "$backend" "$backend_build"
git -C "$backend_build" checkout --detach $(pinned_revision dex-backend)
make -C "$backend_build/dex/idric" driver IDRIC="$frontend/_/build/exec/idris2"
"$grease" "$repository/examples/autogenerated/normal-activity-port/emit.grease" \
  "$repository" "$frontend/_" "$backend_build/dex/idric/build/exec/idric-dex_app/idric-dex.so" \
  "$backend_build/dex/idric/build/ttc" "$baksmali" "$smali" "$output/activity"
"$grease" "$repository/examples/autogenerated/render-pixels/cross-build.grease" \
  "$repository" "$ick_arm64" "$ick_arm64/stage/bin/aarch64-linux-gnu-gcc" arm64-v8a "$ndk" "$output/native/arm64-v8a"
"$grease" "$repository/examples/autogenerated/render-pixels/cross-build.grease" \
  "$repository" "$ick_armv7" "$ick_armv7/stage/bin/arm-linux-gnueabi-gcc" armeabi-v7a "$ndk" "$output/native/armeabi-v7a"
"$grease" "$repository/examples/autogenerated/render-pixels/cross-build.grease" \
  "$repository" "$ick_x64" "$ick_x64/stage/bin/x86_64-linux-gnu-gcc" x86_64 "$ndk" "$output/native/x86_64"
"$grease" "$repository/examples/autogenerated/pure-dex-apk/package.grease" \
  "$repository" "$sdk" "$ndk" "$output/activity" "$output/native" "$output/package"
printf 'application_source_to_DEX\tPASS\nthree_ABI_source_build\tPASS\nunsigned_APK_packaging\tPASS\ninstalled_behavior\tNOT_RUN\nrelease_signing\tNOT_RUN\nphysical_device\tNOT_RUN\n' > "$output/result.tsv"
printf '\033[32mPASS\033[0m source-built unsigned Activity APK; installation and signing are separate\n'
