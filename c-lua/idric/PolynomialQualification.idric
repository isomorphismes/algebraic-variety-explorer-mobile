module PolynomialQualification

import AlgebraicExpression
import Data.Text

-- Derived from Christian Stussak's AlgebraicExpressionWalker.g (2008),
-- Apache-2.0. This is the walker's semantic class distinction, not expansion,
-- numerical evaluation, a sparse polynomial format or an Android ABI.

public export
data Coordinate = CoordinateX | CoordinateY | CoordinateZ

public export
data CoefficientFunction
  = NegateCoefficient
  | SineCoefficient | CosineCoefficient | TangentCoefficient
  | ArcSineCoefficient | ArcCosineCoefficient | ArcTangentCoefficient
  | ExponentialCoefficient | LogarithmicCoefficient | SquareRootCoefficient
  | CeilingCoefficient | FloorCoefficient | AbsoluteCoefficient | SignCoefficient

public export
data ScalarExpression
  = DecimalCoefficient Text
  | FloatingCoefficient Text
  | NamedCoefficient Text
  | ScalarSum ScalarExpression ScalarExpression
  | ScalarDifference ScalarExpression ScalarExpression
  | ScalarProduct ScalarExpression ScalarExpression
  | ScalarQuotient ScalarExpression ScalarExpression
  | ScalarPower ScalarExpression ScalarExpression
  | ScalarFunction CoefficientFunction ScalarExpression
  | ScalarGroup ScalarExpression

-- The original tree walker interprets an overflowing Java Integer exponent as
-- zero. Keep that inherited behavior distinct in the semantic value so a later
-- numerical stage cannot silently mistake it for an ordinary literal zero.
-- Retaining decimal source here also avoids constructing a huge unary Number.
public export
data DecimalExponent
  = InRangeDecimalExponent Text
  | InheritedOverflowExponent Text

public export
data PolynomialExpression
  = CoordinatePolynomial Coordinate
  | ScalarPolynomial ScalarExpression
  | PolynomialSum PolynomialExpression PolynomialExpression
  | PolynomialDifference PolynomialExpression PolynomialExpression
  | PolynomialProduct PolynomialExpression PolynomialExpression
  | PolynomialQuotient PolynomialExpression ScalarExpression
  | PolynomialPower PolynomialExpression DecimalExponent
  | PolynomialNegative PolynomialExpression
  | PolynomialGroup PolynomialExpression

public export
data QualifiedExpression
  = ScalarMeaning ScalarExpression (Maybe DecimalExponent)
  | PolynomialMeaning PolynomialExpression

public export
data QualificationNotice = InheritedExponentOverflowToZero Text

public export
record QualifiedFormula where
  constructor FormulaMeaning
  meaning : QualifiedExpression
  notices : List QualificationNotice

public export
data QualificationError
  = PolynomialDivisor
  | PolynomialExponentRequiresDecimal
  | FunctionRequiresScalar Text
  | UnknownCoefficientFunction Text
  | InheritedRepeatedGroupingLimitation

public export
data FormulaFailure
  = FormulaSyntaxFailure Text
  | FormulaMeaningFailure QualificationError

coefficient_function : Text → Either QualificationError CoefficientFunction
coefficient_function "neg" = Right NegateCoefficient
coefficient_function "sin" = Right SineCoefficient
coefficient_function "cos" = Right CosineCoefficient
coefficient_function "tan" = Right TangentCoefficient
coefficient_function "asin" = Right ArcSineCoefficient
coefficient_function "acos" = Right ArcCosineCoefficient
coefficient_function "atan" = Right ArcTangentCoefficient
coefficient_function "exp" = Right ExponentialCoefficient
coefficient_function "log" = Right LogarithmicCoefficient
coefficient_function "sqrt" = Right SquareRootCoefficient
coefficient_function "ceil" = Right CeilingCoefficient
coefficient_function "floor" = Right FloorCoefficient
coefficient_function "abs" = Right AbsoluteCoefficient
coefficient_function "sign" = Right SignCoefficient
coefficient_function name = Left (UnknownCoefficientFunction name)

-- All decimal text reaching this stage comes from the existing parser's
-- DecimalValue constructor. Equal-length ASCII decimal lexemes have the same
-- order as their nonnegative integer values.
decimal_not_greater : List Char → List Char → Bool
decimal_not_greater [] [] = True
decimal_not_greater [] (_ :: _) = True
decimal_not_greater (_ :: _) [] = False
decimal_not_greater (digit :: remaining) (limit :: rest) =
  if digit < limit then True else
  if digit > limit then False else decimal_not_greater remaining rest

-- Integer.parseInt accepts leading zeroes when given a decimal lexeme directly.
-- Normalize only the comparison; the qualified value retains its source text.
-- This does not broaden the expression lexer's independent admission rule.
decimal_comparison_digits : List Char → List Char
decimal_comparison_digits ['0'] = ['0']
decimal_comparison_digits ('0' :: remaining) = decimal_comparison_digits remaining
decimal_comparison_digits digits = digits

decimal_exponent : Text → DecimalExponent
decimal_exponent source =
  let digits = decimal_comparison_digits (unpack source)
      -- Integer.parseInt in the original walker uses the signed 32-bit maximum.
      maximum = unpack "2147483647"
      fits = length digits < length maximum ||
             (length digits ≟ length maximum && decimal_not_greater digits maximum)
  in if fits then InRangeDecimalExponent source else InheritedOverflowExponent source

as_polynomial : QualifiedExpression → PolynomialExpression
as_polynomial (ScalarMeaning coefficient _) = ScalarPolynomial coefficient
as_polynomial (PolynomialMeaning polynomial) = polynomial

qualified_sum : QualifiedExpression → QualifiedExpression → QualifiedExpression
qualified_sum (ScalarMeaning left _) (ScalarMeaning right _) =
  ScalarMeaning (ScalarSum left right) Nothing
qualified_sum left right = PolynomialMeaning
  (PolynomialSum (as_polynomial left) (as_polynomial right))

qualified_difference : QualifiedExpression → QualifiedExpression → QualifiedExpression
qualified_difference (ScalarMeaning left _) (ScalarMeaning right _) =
  ScalarMeaning (ScalarDifference left right) Nothing
qualified_difference left right = PolynomialMeaning
  (PolynomialDifference (as_polynomial left) (as_polynomial right))

qualified_product : QualifiedExpression → QualifiedExpression → QualifiedExpression
qualified_product (ScalarMeaning left _) (ScalarMeaning right _) =
  ScalarMeaning (ScalarProduct left right) Nothing
qualified_product left right = PolynomialMeaning
  (PolynomialProduct (as_polynomial left) (as_polynomial right))

qualified_quotient : QualifiedExpression → QualifiedExpression →
                     Either QualificationError QualifiedExpression
qualified_quotient (ScalarMeaning left _) (ScalarMeaning right _) =
  Right (ScalarMeaning (ScalarQuotient left right) Nothing)
qualified_quotient (PolynomialMeaning left) (ScalarMeaning right _) =
  Right (PolynomialMeaning (PolynomialQuotient left right))
qualified_quotient _ (PolynomialMeaning _) = Left PolynomialDivisor

exponent_notices : DecimalExponent → List QualificationNotice
exponent_notices (InRangeDecimalExponent _) = []
exponent_notices (InheritedOverflowExponent source) = [InheritedExponentOverflowToZero source]

qualified_power : QualifiedFormula → QualifiedFormula →
                  Either QualificationError QualifiedFormula
qualified_power left right =
  case (left.meaning, right.meaning) of
    (ScalarMeaning base _, ScalarMeaning exponent _) ⇒
      Right (FormulaMeaning (ScalarMeaning (ScalarPower base exponent) Nothing)
        (left.notices ++ right.notices))
    (PolynomialMeaning base, ScalarMeaning _ (Just exponent)) ⇒
      Right (FormulaMeaning (PolynomialMeaning (PolynomialPower base exponent))
        (left.notices ++ right.notices ++ exponent_notices exponent))
    _ ⇒ Left PolynomialExponentRequiresDecimal

export
qualify_expression : Expression → Either QualificationError QualifiedFormula
qualify_expression (DecimalValue source) =
  Right (FormulaMeaning (ScalarMeaning (DecimalCoefficient source)
    (Just (decimal_exponent source))) [])
qualify_expression (FloatingValue source) =
  Right (FormulaMeaning (ScalarMeaning (FloatingCoefficient source) Nothing) [])
qualify_expression (NamedValue "x") =
  Right (FormulaMeaning (PolynomialMeaning (CoordinatePolynomial CoordinateX)) [])
qualify_expression (NamedValue "y") =
  Right (FormulaMeaning (PolynomialMeaning (CoordinatePolynomial CoordinateY)) [])
qualify_expression (NamedValue "z") =
  Right (FormulaMeaning (PolynomialMeaning (CoordinatePolynomial CoordinateZ)) [])
qualify_expression (NamedValue name) =
  Right (FormulaMeaning (ScalarMeaning (NamedCoefficient name) Nothing) [])
qualify_expression (Sum left right) = do
  first ← qualify_expression left
  second ← qualify_expression right
  Right (FormulaMeaning (qualified_sum first.meaning second.meaning)
    (first.notices ++ second.notices))
qualify_expression (Difference left right) = do
  first ← qualify_expression left
  second ← qualify_expression right
  Right (FormulaMeaning (qualified_difference first.meaning second.meaning)
    (first.notices ++ second.notices))
qualify_expression (Product left right) = do
  first ← qualify_expression left
  second ← qualify_expression right
  Right (FormulaMeaning (qualified_product first.meaning second.meaning)
    (first.notices ++ second.notices))
qualify_expression (Quotient left right) = do
  first ← qualify_expression left
  second ← qualify_expression right
  quotient ← qualified_quotient first.meaning second.meaning
  Right (FormulaMeaning quotient (first.notices ++ second.notices))
qualify_expression (Raised left right) = do
  first ← qualify_expression left
  second ← qualify_expression right
  qualified_power first second
qualify_expression (Negative expression) = do
  qualified ← qualify_expression expression
  let negative = case qualified.meaning of
        ScalarMeaning scalar _ ⇒ ScalarMeaning (ScalarFunction NegateCoefficient scalar) Nothing
        PolynomialMeaning polynomial ⇒ PolynomialMeaning (PolynomialNegative polynomial)
  Right (FormulaMeaning negative qualified.notices)
-- The retained generated parser prefixes every function argument with a
-- PARENTHESES token. An explicit group there creates a repeated prefix that
-- its tree walker rejects. Preserve this inherited limitation explicitly;
-- it is not a mathematical restriction on coefficient functions.
qualify_expression (Called _ (Grouped _)) = Left InheritedRepeatedGroupingLimitation
qualify_expression (Called name expression) = do
  argument ← qualify_expression expression
  function ← coefficient_function name
  case argument.meaning of
    ScalarMeaning scalar _ ⇒
      Right (FormulaMeaning (ScalarMeaning (ScalarFunction function scalar) Nothing) argument.notices)
    PolynomialMeaning _ ⇒ Left (FunctionRequiresScalar name)
-- Ordinary single grouping is admitted. The original generated walker's
-- one-prefix limit rejects consecutive groups even though grammar parsing
-- itself succeeds; see the retained original-oracle observations.
qualify_expression (Grouped (Grouped _)) = Left InheritedRepeatedGroupingLimitation
qualify_expression (Grouped expression) = do
  qualified ← qualify_expression expression
  let grouped = case qualified.meaning of
        ScalarMeaning scalar decimal ⇒ ScalarMeaning (ScalarGroup scalar) decimal
        PolynomialMeaning polynomial ⇒ PolynomialMeaning (PolynomialGroup polynomial)
  Right (FormulaMeaning grouped qualified.notices)

export
qualify_formula : Text → Either FormulaFailure QualifiedFormula
qualify_formula source = case parse_formula source of
  Left reason ⇒ Left (FormulaSyntaxFailure reason)
  Right expression ⇒ case qualify_expression expression of
    Left reason ⇒ Left (FormulaMeaningFailure reason)
    Right qualified ⇒ Right qualified

export
qualification_error : QualificationError → Text
qualification_error PolynomialDivisor = "polynomial divisor"
qualification_error PolynomialExponentRequiresDecimal = "polynomial exponent must be a decimal literal"
qualification_error (FunctionRequiresScalar name) = "function requires scalar argument: " ++ name
qualification_error (UnknownCoefficientFunction name) = "unknown coefficient function: " ++ name
qualification_error InheritedRepeatedGroupingLimitation = "inherited repeated-grouping limitation"

notice_report : List QualificationNotice → Text
notice_report [] = ""
notice_report (InheritedExponentOverflowToZero source :: remaining) =
  "; inherited exponent overflow to zero: " ++ source ++ notice_report remaining

export
formula_qualification : Text → Text
formula_qualification source = case qualify_formula source of
  Left (FormulaSyntaxFailure reason) ⇒ "syntax error: " ++ reason
  Left (FormulaMeaningFailure reason) ⇒ "meaning error: " ++ qualification_error reason
  Right qualified ⇒
    let category = case qualified.meaning of
          ScalarMeaning _ _ ⇒ "scalar"
          PolynomialMeaning _ ⇒ "polynomial"
    in category ++ notice_report qualified.notices
