public export data InsetsReference : Type where [external]
public export data ClickListenerReference : Type where [external]
public export data EditorListenerReference : Type where [external]
public export data TouchListenerReference : Type where [external]
public export data InsetsListenerReference : Type where [external]
public export data LayoutListenerReference : Type where [external]
public export data ScaleListenerReference : Type where [external]
public export data DialogListenerReference : Type where [external]
public export data DialogReference : Type where [external]
public export data DialogBuilderReference : Type where [external]
public export data AlertDialogReference : Type where [external]
public export data KeyboardReference : Type where [external]
public export data WindowTokenReference : Type where [external]
public export data IntentReference : Type where [external]
public export data UriReference : Type where [external]
