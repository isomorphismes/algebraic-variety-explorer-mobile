float_value : Int32 → CoordinateFloat
%foreign "dex:static:Landroid/util/TypedValue;:applyDimension:(IFLandroid/util/DisplayMetrics;)F"
dimension_pixels : Int32 → CoordinateFloat → MetricsReference → CoordinateFloat
%foreign "dex:static:Ljava/lang/Math;:round:(F)I"
round_pixels : CoordinateFloat → Int32

export
startup_text : ActivityReference → Text → IO ViewReference
startup_text activity diagnostic = do
  scroller ← primIO (new_scroll (activity_context activity))
  report ← primIO (new_text_view (activity_context activity))
  resources ← primIO (activity_resources activity)
  metrics ← primIO (display_metrics resources)
  let padding = round_pixels (dimension_pixels 1 (float_value 0x41800000) metrics)
  primIO (set_padding (text_view report) padding padding padding padding)
  primIO (text_color report 0xfff3f1ed)
  primIO (background_color (text_view report) 0xff13161b)
  primIO (selectable_text report 1)
  primIO (set_text report ("Algebraic Variety Explorer could not start.\n\n" ++
    "This diagnostic replaces Android’s unhelpful crash message. " ++
    "Please send a screenshot of the text below.\n\n" ++ diagnostic))
  layout_parameters ← primIO (frame_parameters (-1) (-2))
  primIO (add_report scroller (text_view report) (view_parameters layout_parameters))
  primIO (set_content_view activity (scroll_view scroller))
  pure (scroll_view scroller)
