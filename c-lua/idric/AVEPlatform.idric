module AVEPlatform

import AVEInteraction
import RenderedBitmap

-- Each domain has one platform descriptor. Explicit checked casts express
-- Android inheritance/interface use rather than changing the domain's owner.
public export data ActivityReference : Type where [external]
public export data ContextReference : Type where [external]
public export data ResourcesReference : Type where [external]
public export data ViewReference : Type where [external]
public export data EditTextReference : Type where [external]
public export data TextViewReference : Type where [external]
public export data ImageViewReference : Type where [external]
